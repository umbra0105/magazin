generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id
  name           String
  email          String
  emailVerified  Boolean         @default(false)
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sessions       Session[]
  accounts       Account[]
  roles          UserRole[]
  mediaUploads   Media[]
  productImports ProductImport[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Configurare white-label (o instalare = un magazin, fără tenantId)
// ---------------------------------------------------------------------------

/// Setări tipate pe grupuri (general, company, regional, tax, ...). Cheia e `grup.nume`.
model Setting {
  key       String   @id
  group     String
  value     Json
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("setting")
}

/// Un singur rând (id = "default"): token-urile temei, injectate ca CSS variables.
model Branding {
  id         String   @id @default("default")
  preset     String   @default("minimal")
  colors     Json
  fonts      Json
  radius     String
  darkMode   Boolean  @default(false)
  logoUrl    String?
  faviconUrl String?
  ogImageUrl String?
  customCss  String?
  updatedAt  DateTime @updatedAt

  @@map("branding")
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt

  @@map("feature_flag")
}

/// Integrări externe (plăți, curieri, facturare). `credentials` e criptat AES-256-GCM
/// cu APP_KEY și nu iese niciodată în clar din server.
model Integration {
  id          String   @id @default(cuid())
  type        String
  provider    String
  credentials String?
  config      Json     @default("{}")
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([type, provider])
  @@map("integration")
}

/// Jurnal DOAR DE ADĂUGARE: triggerele din migrația audit_log_append_only resping UPDATE/DELETE/TRUNCATE.
/// `actorId` nu e cheie străină: jurnalul trebuie să supraviețuiască ștergerii utilizatorului,
/// iar un ON DELETE SET NULL ar fi un UPDATE. `actorLabel` = emailul actorului la momentul acțiunii.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorLabel String?
  action     String
  entity     String
  entityId   String?
  before     Json?
  after      Json?
  requestId  String?
  /// "success" | "denied" | "failed" (constrângere CHECK în migrație)
  outcome    String   @default("success")
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// RBAC: permisiuni ca string-uri (ex. products.cost.view)
// ---------------------------------------------------------------------------

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  users       UserRole[]

  @@map("role")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role")
}

// ---------------------------------------------------------------------------
// Media (Faza 3): fișierele din biblioteca magazinului
// ---------------------------------------------------------------------------

/// Folder din biblioteca media. Arbore prin `parentId`; numele e unic în același părinte
/// (indecșii parțiali, fără diferență de majuscule, sunt în migrația media_library).
model MediaFolder {
  id        String        @id @default(cuid())
  name      String
  parentId  String?
  parent    MediaFolder?  @relation("MediaFolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  MediaFolder[] @relation("MediaFolderTree")
  media     Media[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([parentId])
  @@map("media_folder")
}

/// Un fișier din bibliotecă. `storageKey` = originalul FĂRĂ EXIF/GPS (păstrat pentru a
/// regenera variantele); `variants` = lista variantelor generate din job. Numele original
/// al fișierului e doar informativ în admin și nu apare niciodată într-un URL.
model Media {
  id              String         @id @default(cuid())
  /// "pending" | "processing" | "ready" | "failed" (constrângere CHECK în migrație)
  status          String         @default("pending")
  mime            String
  sizeBytes       Int
  width           Int?
  height          Int?
  /// SHA-256 (hex) al originalului stocat; permite detectarea dublurilor
  checksum        String
  /// SHA-256 (hex) al adresei sursă normalizate, pentru imaginile aduse prin import din adresă (idempotență: aceeași
  /// adresă nu produce un al doilea fișier). `null` la fișierele încărcate de utilizator.
  sourceHash      String?        @unique
  originalName    String
  storageKey      String         @unique
  /// [{ name, format, key, width, height, sizeBytes }]
  variants        Json           @default("[]")
  blurhash        String?
  alt             String         @default("")
  tags            String[]       @default([])
  folderId        String?
  folder          MediaFolder?   @relation(fields: [folderId], references: [id], onDelete: Restrict)
  processingError String?
  uploadedById    String?
  uploadedBy      User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  productMedia    ProductMedia[]
  partsDiagrams   PartsDiagram[]
  categories      Category[]
  brands          Brand[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([folderId])
  @@index([status])
  @@index([checksum])
  @@index([createdAt])
  @@index([uploadedById])
  @@index([tags], type: Gin)
  @@map("media")
}

// ---------------------------------------------------------------------------
// Catalog (Faza 4): produse, variante, categorii, branduri, media pe produs
// ---------------------------------------------------------------------------

/// Brandul produselor (opțional pe produs; eMAG îl cere la publicare). `legacyId`/`legacyUrl` = identificatorul și
/// adresa din magazinul WooCommerce de unde se migrează (import repetabil + redirecționări 301 la lansare).
model Brand {
  id                  String    @id @default(cuid())
  slug                String    @unique
  name                String
  description         String?
  seoTitle            String?
  seoDescription      String?
  legacyId            String?   @unique
  legacyUrl           String?
  /// Termenul implicit „La comandă” (în zile) al produselor brandului care nu au unul propriu; gol = setarea globală
  defaultLeadTimeDays Int?
  /// Logoul din biblioteca media (FK Restrict + provider de utilizare media)
  logoMediaId         String?
  logoMedia           Media?    @relation(fields: [logoMediaId], references: [id], onDelete: Restrict)
  products            Product[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([logoMediaId])
  @@map("brand")
}

/// Categorie într-un arbore (`parentId`). `path` = calea de slug-uri (ex. `pompe/pompe-filtrare`),
/// `depth` = adâncimea (0 = rădăcină); ambele sunt calculate de serviciu, nu editate direct.
model Category {
  id                       String                   @id @default(cuid())
  parentId                 String?
  parent                   Category?                @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children                 Category[]               @relation("CategoryTree")
  slug                     String
  name                     String
  description              String?
  path                     String                   @unique
  depth                    Int                      @default(0)
  sortOrder                Int                      @default(0)
  /// Produsele din categorie costă prețul public pentru toate grupurile (`09` §1)
  excludeFromGroupDiscount Boolean                  @default(false)
  seoTitle                 String?
  seoDescription           String?
  legacyId                 String?                  @unique
  legacyUrl                String?
  /// Imaginea categoriei din biblioteca media (FK Restrict + provider de utilizare media)
  imageMediaId             String?
  imageMedia               Media?                   @relation(fields: [imageMediaId], references: [id], onDelete: Restrict)
  products                 ProductCategory[]
  channelMaps              ChannelCategoryMapping[]
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@index([parentId])
  @@index([imageMediaId])
  @@map("category")
}

/// Produsul vandabil. Prețurile, EAN-ul, garanția, greutatea și costul stau pe VARIANTĂ (un produs
/// simplu are o singură variantă implicită). `slug` e unic pe TOATE produsele, inclusiv cele șterse (index
/// `product_slug_key`, fără diferență de majuscule). `deletedAt` = soft delete.
model Product {
  id                       String                @id @default(cuid())
  slug                     String
  title                    String
  subtitle                 String?
  description              String?
  /// "draft" | "active" | "archived" (CHECK în migrație)
  status                   String                @default("draft")
  /// "physical" | "digital" (CHECK în migrație)
  type                     String                @default("physical")
  /// Opțional: magazinul poate să nu folosească mărci. Obligatoriu doar la publicarea pe un canal care îl cere (eMAG).
  brandId                  String?
  brand                    Brand?                @relation(fields: [brandId], references: [id], onDelete: Restrict)
  /// Pregătit pentru cote reduse; nefolosit (vezi `TaxClass`). Calculul folosește `tax.standardRate`.
  taxClassId               String?
  taxClass                 TaxClass?             @relation(fields: [taxClassId], references: [id], onDelete: Restrict)
  /// "standard" | "oversized" | "pallet" (CHECK în migrație). Regulile pe clase vin la Faza 12.
  shippingClass            String                @default("standard")
  requiresInstallation     Boolean               @default(false)
  /// Clasa energetică afișată înaintea finalizării comenzii: A+++ … G (CHECK în migrație)
  energyClass              String?
  /// Link către înregistrarea EPREL (https, CHECK în migrație)
  eprelUrl                 String?
  /// GPSR: producătorul produsului (nume, adresă și contact)
  gpsrManufacturerName     String?
  gpsrManufacturerContact  String?
  /// GPSR: persoana responsabilă din UE, dacă producătorul e din afara UE
  gpsrResponsibleName      String?
  gpsrResponsibleContact   String?
  /// GPSR: avertismente de siguranță și instrucțiuni
  safetyWarnings           String?
  /// Câmpuri pregătitoare (Faza 5 / Val 2), nefolosite încă
  expectedRestockDate      DateTime?
  allowBackorder           Boolean               @default(false)
  /// Valoarea implicită vine din setarea `inventory.manageStock`; aici e suprascrierea per produs.
  manageStock              Boolean               @default(true)
  /// "instock" | "outofstock" | "onbackorder" (CHECK); folosit când `manageStock = false`
  stockStatus              String                @default("instock")
  /// Termenul „La comandă” în zile (0–365); gol = implicitul brandului, apoi setarea globală
  leadTimeDays             Int?
  /// Unitatea de măsură a produsului (D11); gol = bucată (pas 1). Varianta o poate suprascrie.
  measureUnitId            String?
  measureUnit              MeasureUnit?          @relation(fields: [measureUnitId], references: [id], onDelete: Restrict)
  /// La ce se referă `price` al variantelor: "unit" (preț pe unitate: lei/ml) | "step" (preț pe pas: lei/sac); CHECK
  priceBasis               String                @default("unit")
  /// Pasul de vânzare în zecimi de miime de unitate (25000 = 2,5 ml); gol = o unitate. Cantitatea comandată e multiplu exact.
  saleStep                 Int?
  /// Minimul comandat, în pași (gol = 1)
  minSteps                 Int?
  /// Arată și prețul unui pas (ex. „Rola de 41,25 mp ≈ …”)
  showStepPrice            Boolean               @default(false)
  excludeFromGroupDiscount Boolean               @default(false)
  seoTitle                 String?
  seoDescription           String?
  publishedAt              DateTime?
  sortOrder                Int                   @default(0)
  metadata                 Json                  @default("{}")
  legacyId                 String?               @unique
  legacyUrl                String?
  deletedAt                DateTime?
  variants                 ProductVariant[]
  categories               ProductCategory[]
  media                    ProductMedia[]
  options                  ProductOption[]
  attributes               AttributeValue[]
  collections              CollectionProduct[]
  relations                ProductRelation[]     @relation("ProductRelations")
  relatedTo                ProductRelation[]     @relation("RelatedProducts")
  importImages             ProductImportImage[]
  documents                ProductDocument[]
  channelListings          ChannelListing[]
  partsDiagrams            PartsDiagramProduct[]
  hotspots                 PartsDiagramHotspot[]
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  @@index([brandId])
  @@index([taxClassId])
  @@index([status])
  @@index([deletedAt])
  @@map("product")
}

model ProductCategory {
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// O singură categorie primară per produs (index parțial în migrație)
  isPrimary  Boolean  @default(false)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_category")
}

/// Variantă vandabilă. Sumele sunt `int` în bani. `price` = BRUT (cu TVA inclus), `salePrice` = prețul
/// promoțional brut (în intervalul `saleStartsAt`–`saleEndsAt`, dacă sunt setate). `costPrice` = prețul de
/// achiziție NET (fără TVA), ⚠️ DOAR pentru admin (`products.cost.view`): niciodată în API public, props
/// către componente client, feed-uri, snapshot de comandă sau loguri.
model ProductVariant {
  id                     String               @id @default(cuid())
  productId              String
  product                Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                    String               @unique
  /// GTIN (8-14 cifre). Nu e NOT NULL în bază (draft-uri, import); obligatoriu la publicarea pe eMAG.
  ean                    String?
  /// Garanția în luni. Nu e NOT NULL în bază (valoarea implicită e o decizie de business); obligatorie la eMAG.
  warrantyMonths         Int?
  price                  Int
  salePrice              Int?
  saleStartsAt           DateTime?
  saleEndsAt             DateTime?
  costPrice              Int?
  costPriceDate          DateTime?
  /// Greutate în grame, dimensiuni în milimetri (întregi; transportul folosește max(real, volumetric))
  weightGrams            Int?
  lengthMm               Int?
  widthMm                Int?
  heightMm               Int?
  /// Suprascrierea per variantă a lui `Product.manageStock` (null = moștenește de la produs)
  manageStock            Boolean?
  /// "instock" | "outofstock" | "onbackorder" (CHECK); suprascrie `Product.stockStatus` (null = moștenește)
  stockStatus            String?
  /// Unitate, bază de preț, pas și minim: nul = moștenește de la produs (ca `manageStock`)
  measureUnitId          String?
  measureUnit            MeasureUnit?         @relation(fields: [measureUnitId], references: [id], onDelete: Restrict)
  priceBasis             String?
  saleStep               Int?
  minSteps               Int?
  /// Cum ține SmartBill stocul acestei variante: "same_unit" (aceeași unitate) | "steps" (1 bucată SmartBill = 1 pas)
  /// | "ratio" (1 unitate SmartBill = `smartbillRatio` zecimi de miime din unitatea noastră); gol = aceeași unitate
  smartbillMode          String?
  smartbillUnitName      String?
  smartbillRatio         Int?
  position               Int                  @default(0)
  isDefault              Boolean              @default(false)
  legacyId               String?              @unique
  media                  ProductMedia[]
  costHistory            CostPriceHistory[]
  priceHistory           PriceHistory[]
  /// Piese de schimb: codul și numele producătorului (căutare exactă pe cod; indexul trigram vine cu căutarea, Faza 7)
  manufacturerPartNumber String?
  manufacturerName       String?
  optionValues           VariantOptionValue[]
  channelListings        ChannelListing[]
  inventoryItems         InventoryItem[]
  stockMovements         StockMovement[]
  backInStockAlerts      BackInStockAlert[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@unique([id, productId])
  @@index([productId])
  @@index([ean])
  @@map("product_variant")
}

/// Istoricul prețurilor de achiziție NET. ⚠️ DOAR admin, ca `ProductVariant.costPrice`.
model CostPriceHistory {
  id            String         @id @default(cuid())
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  costPrice     Int
  effectiveDate DateTime
  /// "manual" | "import" (CHECK în migrație)
  source        String
  importId      String?
  createdAt     DateTime       @default(now())

  @@index([variantId, effectiveDate])
  @@map("cost_price_history")
}

/// Prețul public brut în vigoare al unei variante de la `effectiveFrom` încolo (valoarea efectivă:
/// min(preț, promoție activă)). Sursa pentru „cel mai mic preț din ultimele 30 de zile” (Omnibus).
/// Se scrie la fiecare schimbare a prețului efectiv; vezi `lowestPriceInWindow` din `@ecom/core`.
model PriceHistory {
  id            String         @id @default(cuid())
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  price         Int
  effectiveFrom DateTime

  @@unique([variantId, effectiveFrom])
  @@map("price_history")
}

/// Fișier din bibliotecă atașat unui produs (sau unei variante a lui). `onDelete: Restrict` spre `Media`
/// e plasa de siguranță sub `ProductMediaUsageProvider`: un fișier folosit nu se poate șterge nici dacă
/// providerul nu e înregistrat. `position` 0 = imaginea principală.
model ProductMedia {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId, productId], references: [id, productId], onDelete: Cascade)
  mediaId   String
  media     Media           @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  position  Int             @default(0)
  createdAt DateTime        @default(now())

  @@index([productId, position])
  @@index([variantId])
  @@index([mediaId])
  @@map("product_media")
}

// ---------------------------------------------------------------------------
// Catalog (Faza 4, punctul 3): opțiuni, colecții, atribute, relații, clase de taxare
// ---------------------------------------------------------------------------

/// Opțiune de variantă (ex. „Mărime”, „Culoare”) a unui produs. Numele e unic per produs (fără
/// diferență de majuscule, index parțial în migrație).
model ProductOption {
  id        String               @id @default(cuid())
  productId String
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  position  Int                  @default(0)
  values    OptionValue[]
  variants  VariantOptionValue[]

  @@unique([id, productId])
  @@index([productId, position])
  @@map("product_option")
}

model OptionValue {
  id       String               @id @default(cuid())
  optionId String
  option   ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value    String
  position Int                  @default(0)
  variants VariantOptionValue[]

  @@unique([id, optionId])
  @@index([optionId, position])
  @@map("option_value")
}

/// Valoarea unei opțiuni pentru o variantă. Cheile compuse garantează în bază că varianta, opțiunea și
/// valoarea sunt ale aceluiași produs și că o variantă are cel mult o valoare per opțiune (PK).
model VariantOptionValue {
  variantId     String
  productId     String
  optionId      String
  optionValueId String
  variant       ProductVariant @relation(fields: [variantId, productId], references: [id, productId], onDelete: Cascade)
  option        ProductOption  @relation(fields: [optionId, productId], references: [id, productId], onDelete: Cascade)
  value         OptionValue    @relation(fields: [optionValueId, optionId], references: [id, optionId], onDelete: NoAction)

  @@id([variantId, optionId])
  @@index([optionValueId])
  @@map("variant_option_value")
}

/// Colecție de produse: `manual` (listă în `CollectionProduct`) sau `automated` (reguli în `rules`,
/// evaluate de storefront în Faza 7).
model Collection {
  id             String              @id @default(cuid())
  slug           String
  name           String
  description    String?
  /// "manual" | "automated" (CHECK în migrație)
  type           String              @default("manual")
  rules          Json                @default("{}")
  sortOrder      Int                 @default(0)
  seoTitle       String?
  seoDescription String?
  legacyId       String?             @unique
  products       CollectionProduct[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@map("collection")
}

model CollectionProduct {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  position     Int        @default(0)

  @@id([collectionId, productId])
  @@index([productId])
  @@map("collection_product")
}

/// Atribut tehnic. `type` = text | number | select | bool. Cele `number` au unitate de măsură (`unit`:
/// m³/h, kW, m³) și, dacă `isFilterable`, se filtrează pe interval (slider) în Faza 7; valorile se
/// stochează ca numere exacte (`numberValue`), nu ca text. `code` e cheia stabilă (import, filtre).
model Attribute {
  id           String            @id @default(cuid())
  code         String            @unique
  name         String
  /// "text" | "number" | "select" | "bool" (CHECK în migrație)
  type         String
  /// Doar la `number` (CHECK în migrație)
  unit         String?
  isFilterable Boolean           @default(false)
  sortOrder    Int               @default(0)
  options      AttributeOption[]
  values       AttributeValue[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("attribute")
}

/// Valoare permisă a unui atribut de tip `select`.
model AttributeOption {
  id          String           @id @default(cuid())
  attributeId String
  attribute   Attribute        @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  position    Int              @default(0)
  values      AttributeValue[]

  @@unique([id, attributeId])
  @@index([attributeId, position])
  @@map("attribute_option")
}

/// Valoarea unui atribut pe un produs. Exact UNA dintre `textValue`, `numberValue`, `boolValue`,
/// `optionId` e setată (CHECK), iar un trigger din migrație cere ca ea să corespundă tipului atributului.
/// `numberValue`: NUMERIC(18,4), exact (nu `float`).
model AttributeValue {
  id          String           @id @default(cuid())
  productId   String
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   Attribute        @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  textValue   String?
  numberValue Decimal?         @db.Decimal(18, 4)
  boolValue   Boolean?
  optionId    String?
  option      AttributeOption? @relation(fields: [optionId, attributeId], references: [id, attributeId], onDelete: Restrict)

  @@unique([productId, attributeId])
  @@index([attributeId, numberValue])
  @@index([attributeId, optionId])
  @@map("attribute_value")
}

/// Relație între produse. Sensul: `productId` e produsul „principal”, `relatedProductId` cel asociat:
/// `accessory` / `upsell` / `crosssell` / `similar` (ale produsului principal), `spare_part` (piesa de
/// schimb a produsului principal) și `compatible_with` (produsul principal e compatibil cu cel asociat).
model ProductRelation {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation("ProductRelations", fields: [productId], references: [id], onDelete: Cascade)
  relatedProductId String
  relatedProduct   Product  @relation("RelatedProducts", fields: [relatedProductId], references: [id], onDelete: Cascade)
  /// "similar" | "accessory" | "upsell" | "crosssell" | "spare_part" | "compatible_with" (CHECK)
  type             String
  position         Int      @default(0)
  createdAt        DateTime @default(now())

  @@unique([productId, relatedProductId, type])
  @@index([relatedProductId])
  @@map("product_relation")
}

/// Clasă de taxare, PREGĂTITĂ pentru cote reduse pe viitor. DECIZIE (utilizator, Faza 4): produsele
/// folosesc doar cota standard din setarea `tax.standardRate` (21%); `TaxClass`/`TaxRate` nu sunt
/// expuse în admin, nu schimbă calculul prețurilor și nu se seedează nicio cotă (nimic hardcodat).
model TaxClass {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  isDefault Boolean   @default(false)
  rates     TaxRate[]
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("tax_class")
}

/// Cota unei clase de taxare, în puncte de bază (`2100` = 21%), valabilă de la `validFrom`.
model TaxRate {
  id         String   @id @default(cuid())
  taxClassId String
  taxClass   TaxClass @relation(fields: [taxClassId], references: [id], onDelete: Cascade)
  rateBps    Int
  validFrom  DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([taxClassId, validFrom])
  @@map("tax_rate")
}

// ---------------------------------------------------------------------------
// Catalog (Faza 4, punctul 4): documente, fișe explodate, câmpuri de nișă și GPSR
// ---------------------------------------------------------------------------

/// Document al produsului (etichetă energetică, fișă tehnică, manual, declarație CE...), încărcat manual.
/// Fișierul stă în storage sub `storageKey` (nu în biblioteca de imagini: acolo intră doar imagini, iar
/// documentele sunt de obicei PDF). `showInTab` = apare în tabul „Descărcări” de pe pagina produsului.
model ProductDocument {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// "energy_label" | "product_sheet" | "manual" | "ce_declaration" | "datasheet" | "warranty" | "other" (CHECK)
  type         String
  title        String
  storageKey   String   @unique
  originalName String
  mime         String
  sizeBytes    Int
  /// Cod de limbă din două litere (ro, en)
  language     String   @default("ro")
  position     Int      @default(0)
  showInTab    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId, position])
  @@map("product_document")
}

/// Fișa explodată: entitate proprie, atașabilă la mai multe produse (o familie de pompe are aceeași fișă
/// pentru 6 modele). Imaginea e un fișier din bibliotecă (`mediaId`, cu provider de utilizare media).
model PartsDiagram {
  id        String                @id @default(cuid())
  title     String
  mediaId   String
  media     Media                 @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  products  PartsDiagramProduct[]
  hotspots  PartsDiagramHotspot[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([mediaId])
  @@map("parts_diagram")
}

model PartsDiagramProduct {
  diagramId String
  diagram   PartsDiagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([diagramId, productId])
  @@index([productId])
  @@map("parts_diagram_product")
}

/// Rândul numerotat al fișei (varianta A: tabel; `xBp`/`yBp` nule) și, în varianta B (Val 2), poziția
/// punctului pe imagine, în sutimi de procent (0 = marginea stângă/de sus, 10000 = dreapta/jos).
/// `productId` = piesa de schimb din catalog; `label` opțional, dacă diferă de numele produsului.
model PartsDiagramHotspot {
  id        String       @id @default(cuid())
  diagramId String
  diagram   PartsDiagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  number    Int
  xBp       Int?
  yBp       Int?
  /// Piesa din catalog. Nulă când produsul a fost șters definitiv: hotspot-ul rămâne în fișă (se
  /// vede ca „fără produs” în editor), nu dispare odată cu produsul.
  productId String?
  product   Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  label     String?

  @@unique([diagramId, number])
  @@index([productId])
  @@map("parts_diagram_hotspot")
}

// ---------------------------------------------------------------------------
// Canale de vânzare (Faza 4, punctul 5): web (implicit) și, mai târziu, eMAG
// ---------------------------------------------------------------------------

/// Canal de vânzare. `web` e creat de seed (sistem, nu se șterge). `config` conține DOAR setări
/// nesecrete; cheile API ale unui canal extern stau criptate în `Integration`, nu aici.
/// `requiresEan`/`requiresBrand`: canalul cere EAN pe variantă și brand pe produs LA PUBLICARE
/// (eMAG); în rest, ambele rămân opționale în catalog.
model SalesChannel {
  id            String                   @id @default(cuid())
  code          String                   @unique
  name          String
  isActive      Boolean                  @default(true)
  /// Canalul de sistem (`web`): nu se poate șterge (trigger în migrație)
  isSystem      Boolean                  @default(false)
  requiresEan   Boolean                  @default(false)
  requiresBrand Boolean                  @default(false)
  config        Json                     @default("{}")
  listings      ChannelListing[]
  categoryMaps  ChannelCategoryMapping[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@map("sales_channel")
}

/// Oferta unei variante pe un canal. `price`/`salePrice`/`stock` sunt valorile specifice canalului
/// (nule = cele ale magazinului). Pentru canalul `web` nu se creează rânduri (oferta e catalogul însuși).
model ChannelListing {
  id                 String         @id @default(cuid())
  channelId          String
  channel            SalesChannel   @relation(fields: [channelId], references: [id], onDelete: Restrict)
  productId          String
  product            Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId          String
  variant            ProductVariant @relation(fields: [variantId, productId], references: [id, productId], onDelete: Cascade)
  /// ID-ul ofertei la canal (eMAG: id-ul ofertei)
  externalId         String?
  /// Identificatorul produsului în catalogul canalului (eMAG: part_number_key)
  externalProductKey String?
  /// "draft" | "pending" | "active" | "rejected" | "inactive" (CHECK în migrație)
  status             String         @default("draft")
  price              Int?
  salePrice          Int?
  stock              Int?
  /// Ce a respins canalul și de ce: [{ code, message, field? }]
  validationErrors   Json           @default("[]")
  lastSyncAt         DateTime?
  /// "ok" | "error" (CHECK în migrație)
  lastSyncStatus     String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([channelId, variantId])
  @@index([productId])
  @@index([channelId, status])
  @@map("channel_listing")
}

/// Maparea unei categorii proprii la categoria canalului și a atributelor la caracteristicile lui.
model ChannelCategoryMapping {
  id                 String       @id @default(cuid())
  channelId          String
  channel            SalesChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  categoryId         String
  category           Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  externalCategoryId String
  /// { "<codul atributului nostru>": "<caracteristica canalului>" }
  characteristicsMap Json         @default("{}")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([channelId, categoryId])
  @@index([categoryId])
  @@map("channel_category_mapping")
}

// ---------------------------------------------------------------------------
// Import de produse (Faza 4, punctul 14a)
// ---------------------------------------------------------------------------

/// Un import de produse dintr-un fișier CSV/XLSX, în pașii lui: încărcat → verificat (dry-run, fără
/// modificări în catalog) → aplicat (sincron sau în fundal). Fișierul stă privat în storage sub
/// `storageKey` (cheie generată de server) și se șterge după aplicare, la anulare sau la expirare.
/// `planHash` leagă aplicarea de ce a fost verificat. `summary` și `report` conțin doar numere, SKU-uri
/// și mesaje; niciodată prețul de achiziție sau conținutul câmpurilor lungi.
model ProductImport {
  id            String    @id @default(cuid())
  createdById   String?
  createdBy     User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  /// "uploaded" | "validated" | "queued" | "running" | "completed" | "failed" (CHECK în migrație)
  status        String    @default("uploaded")
  fileName      String
  /// "csv" | "xlsx" (CHECK în migrație)
  format        String
  sizeBytes     Int
  /// SHA-256 (hex) al fișierului stocat
  fileHash      String
  /// Cheia fișierului în storage privat; `null` după ștergerea lui
  storageKey    String?   @unique
  /// Delimitatorul ales la CSV
  delimiter     String?
  /// Câmpul fiecărei coloane (în ordine), salvat la verificare
  mapping       Json?
  planHash      String?
  rowCount      Int
  processedRows Int       @default(0)
  summary       Json?
  report        Json?
  errorMessage  String?
  expiresAt     DateTime
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  images ProductImportImage[]

  @@index([createdById])
  @@index([expiresAt])
  @@map("product_import")
}

/// O imagine de adus dintr-o adresă, în cadrul unui import WooCommerce (punctul 15b). Sarcinile se creează la
/// aplicare (după produse) și se execută în fundal: o imagine eșuată nu strică produsul și se reîncearcă la rulări
/// următoare. Adresa e cea NORMALIZATĂ (https, gazdă permisă); motivul eșecului e un COD stabil, niciodată IP-uri,
/// anteturi sau corpuri de răspuns.
model ProductImportImage {
  id         String        @id @default(cuid())
  importId   String
  import     ProductImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Rândul din fișier și SKU-ul, pentru raport
  row        Int
  sku        String
  /// Ordinea în fișier, în cadrul produsului (prima = principală dacă produsul nu are imagini)
  position   Int
  sourceUrl  String
  sourceHash String
  host       String
  /// "pending" | "downloaded" | "existing" | "failed" (CHECK în migrație)
  status     String        @default("pending")
  /// Cod stabil al motivului (ex. host_not_allowed, too_large, not_image); null când n-a eșuat
  reason     String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([importId, status])
  @@index([productId])
  @@map("product_import_image")
}

// ---------------------------------------------------------------------------
// Stoc (Faza 5): unități de măsură, depozite, stoc, mișcări, rezervări, angajări, alerte
// Toate cantitățile sunt ÎNTREGI în zecimi de miime de unitate (4 zecimale; 25000 = 2,5): BIGINT pentru stoc,
// INT pentru pas și rapoarte de conversie. Niciun `float`. Modulul `Quantity` din `@ecom/shared` e singura aritmetică.
// ---------------------------------------------------------------------------

/// Unitate de măsură a vânzării și a stocului (buc, ml, mp, kg …). `decimals` = câte zecimale are voie cantitatea
/// (0–4). `smartbillName` = cum se numește unitatea în SmartBill. Unitățile de sistem nu se șterg; una folosită nici atât.
model MeasureUnit {
  id            String           @id @default(cuid())
  code          String           @unique
  name          String
  symbol        String
  smartbillName String?
  decimals      Int              @default(0)
  isActive      Boolean          @default(true)
  isSystem      Boolean          @default(false)
  sortOrder     Int              @default(0)
  products      Product[]
  variants      ProductVariant[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("measure_unit")
}

/// Locația stocului. Interfața arată o singură locație („Depozit principal”, redenumibilă); modelul multi-depozit
/// rămâne în bază, în spatele flag-ului `multiWarehouse`. Exact un depozit implicit (index parțial unic în migrație).
model Warehouse {
  id        String          @id @default(cuid())
  code      String          @unique
  name      String
  isDefault Boolean         @default(false)
  isActive  Boolean         @default(true)
  items     InventoryItem[]
  movements StockMovement[]
  snapshots StockSnapshot[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("warehouse")
}

/// Stocul unei variante gestionate într-un depozit. `physical` = cantitatea fizică din ultima poză SmartBill (plus
/// ajustările de după ea), valabilă la `physicalAsOf`; `committed` = „angajat” (comenzi confirmate, încă neoglindite în
/// poză); `reserved` = ținut pentru plăți în curs. Disponibil = physical − committed − reserved (niciodată sub 0).
/// ZERO rânduri pentru produsele cu `manageStock = false`. Toate cantitățile ≥ 0 (D5), garantat de CHECK.
model InventoryItem {
  id            String             @id @default(cuid())
  variantId     String
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouseId   String
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  physical      BigInt             @default(0)
  physicalAsOf  DateTime?
  committed     BigInt             @default(0)
  reserved      BigInt             @default(0)
  /// Tamponul de siguranță (în unitatea variantei): cantitatea ținută în rezervă la calculul disponibilului
  safetyBuffer  BigInt             @default(0)
  /// Pragul „stoc mic” în PAȘI; gol = setarea globală `inventory.lowStockSteps`
  lowStockSteps Int?
  reservations  StockReservation[]
  commitments   StockCommitment[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([variantId, warehouseId])
  @@index([warehouseId])
  @@map("inventory_item")
}

/// „Poza” periodică a stocului din SmartBill (import acum, API mai târziu): data valabilității, fișierul, numărul de
/// rânduri și raportul. Se aplică toată sau deloc. `actorId` nu e cheie străină (istoricul supraviețuiește utilizatorului).
model StockSnapshot {
  id          String          @id @default(cuid())
  warehouseId String
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  /// Ora la care e valabilă poza (nu ora încărcării)
  takenAt     DateTime
  /// "import" | "api" (CHECK)
  source      String
  fileName    String?
  fileHash    String?
  rowCount    Int             @default(0)
  actorId     String?
  actorLabel  String?
  report      Json            @default("{}")
  movements   StockMovement[]
  createdAt   DateTime        @default(now())

  @@index([warehouseId, takenAt])
  @@map("stock_snapshot")
}

/// Registru IMUABIL al schimbărilor de stoc (trigger: nicio modificare, ștergere sau golire). `effectiveAt` = ora
/// efectivă a faptului (regula „poza înlocuiește ajustările dinainte”), `createdAt` = ora scrierii. Referința
/// generică (`refType`, `refId`) leagă mișcarea de o comandă fără a depinde de tabela `Order`. Nu are chei străine
/// spre utilizator (istoricul supraviețuiește conturilor) și blochează ștergerea definitivă a variantei.
model StockMovement {
  id             String         @id @default(cuid())
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouseId    String
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  /// "adjustment" | "snapshot" | "commit" | "release" | "mirror" | "transfer_in" | "transfer_out" (CHECK)
  kind           String
  /// Motiv fix, obligatoriu la ajustări: "sale_in_store" | "receipt" | "return" | "inventory_correction" | "damaged"
  /// | "lost_stolen" | "other" (CHECK)
  reason         String?
  /// Text liber, obligatoriu la ajustări
  note           String?
  deltaPhysical  BigInt         @default(0)
  deltaCommitted BigInt         @default(0)
  physicalAfter  BigInt
  committedAfter BigInt
  effectiveAt    DateTime       @default(now())
  refType        String?
  refId          String?
  snapshotId     String?
  snapshot       StockSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  actorId        String?
  actorLabel     String?
  createdAt      DateTime       @default(now())

  @@index([variantId, effectiveAt])
  @@index([warehouseId, effectiveAt])
  @@index([refType, refId])
  @@index([snapshotId])
  @@map("stock_movement")
}

/// Rezervare pentru o plată în curs (card: 15 minute; transfer bancar: zile lucrătoare). Coșul NU rezervă.
/// O singură rezervare activă sau confirmată per referință și linie (index parțial unic în migrație).
/// Stări: "active" | "confirmed" | "released" | "expired" (CHECK, cu momentele coerente).
model StockReservation {
  id          String        @id @default(cuid())
  variantId   String
  warehouseId String
  item        InventoryItem @relation(fields: [variantId, warehouseId], references: [variantId, warehouseId], onDelete: Restrict)
  quantity    BigInt
  status      String        @default("active")
  refType     String
  refId       String
  expiresAt   DateTime
  confirmedAt DateTime?
  releasedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, expiresAt])
  @@index([variantId, warehouseId, status])
  @@index([refType, refId])
  @@map("stock_reservation")
}

/// „Angajat”: cantitate dintr-o comandă confirmată, încă neoglindită în poza SmartBill (D1). Referință generică
/// (tip + id) în locul unei chei străine spre `Order` (tabela apare în Faza 9, unde se înlocuiește cu cheie străină,
/// cu validarea datelor existente). Unic per comandă și linie: aceeași comandă nu poate angaja de două ori, nici
/// după eliberare. `invoicedAt` = ora facturii (se compară cu ora pozei). Stări: "open" | "mirrored" | "released".
model StockCommitment {
  id          String        @id @default(cuid())
  variantId   String
  warehouseId String
  item        InventoryItem @relation(fields: [variantId, warehouseId], references: [variantId, warehouseId], onDelete: Restrict)
  quantity    BigInt
  status      String        @default("open")
  refType     String
  refId       String
  committedAt DateTime      @default(now())
  invoicedAt  DateTime?
  mirroredAt  DateTime?
  releasedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([refType, refId, variantId, warehouseId], map: "stock_commitment_ref_key")
  @@index([variantId, warehouseId, status])
  @@map("stock_commitment")
}

/// „Anunță-mă când revine”: adresa se păstrează doar până la trimiterea unică (apoi se șterge) sau o perioadă
/// limitată (`inventory.backInStockRetentionDays`). O cerere în așteptare per variantă și adresă (index parțial).
model BackInStockAlert {
  id         String         @id @default(cuid())
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  email      String
  notifiedAt DateTime?
  createdAt  DateTime       @default(now())

  @@index([variantId, notifiedAt])
  @@map("back_in_stock_alert")
}
