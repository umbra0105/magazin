generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                  @id
  name                String
  email               String
  emailVerified       Boolean                 @default(false)
  image               String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  sessions            Session[]
  accounts            Account[]
  roles               UserRole[]
  mediaUploads        Media[]
  productImports      ProductImport[]
  cart                Cart?
  savedOrderViews     OrderSavedView[]
  notificationReads   AdminNotificationRead[]
  /// Faza 14: anonimizarea contului (ștergere cerută de client); după ea contul nu mai poate fi folosit.
  anonymizedAt        DateTime?
  customerAddresses   CustomerAddress[]
  wishlistItems       WishlistItem[]
  preference          CustomerPreference?
  returnRequests      ReturnRequest[]
  digitalEntitlements DigitalEntitlement[]
  /// Faza 15: grupul de clienți (prețuri de grup). Nul = «Client standard» (prețul public). Atribuit MANUAL, de admin.
  customerGroupId     String?
  customerGroup       CustomerGroup?          @relation(fields: [customerGroupId], references: [id], onDelete: Restrict)
  nirImports          NirImport[]
  loyaltyAccount      LoyaltyAccount?

  @@unique([email])
  @@index([customerGroupId])
  @@map("user")
}

/// Grupurile de clienți (Faza 15, docs/09 §1). `pricingType`: none (prețul public) | discount (prețul public minus `discountBps`) |
/// cost_plus (prețul de achiziție + `markupBps` + TVA, plafonat la prețul public curent). Procentele sunt întregi în puncte de
/// bază, niciodată float. «Client standard» (`isSystem`, `none`) există din instalare și nu se șterge; celelalte sunt un seed
/// specific magazinului, editabile din admin. `tone` = cheia tonului badge-ului din tokenii adminului (nu o culoare).
model CustomerGroup {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  pricingType         String   @default("none")
  discountBps         Int?
  markupBps           Int?
  /// Doar la `discount`: reducerea de grup se aplică peste prețul promoțional (altfel se ia cel mai mic dintre cele două).
  stacksWithSalePrice Boolean  @default(false)
  /// Fals la Partener 1/2/3 (loialitatea e în Faza 15b; coloana există de acum).
  earnsLoyaltyPoints  Boolean  @default(true)
  tone                String   @default("neutral")
  isSystem            Boolean  @default(false)
  isActive            Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  users               User[]
  orders              Order[]

  @@index([sortOrder])
  @@map("customer_group")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Configurare white-label (o instalare = un magazin, fără tenantId)
// ---------------------------------------------------------------------------

/// Setări tipate pe grupuri (general, company, regional, tax, ...). Cheia e `grup.nume`.
model Setting {
  key       String   @id
  group     String
  value     Json
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("setting")
}

/// Un singur rând (id = "default"): token-urile temei, injectate ca CSS variables.
model Branding {
  id         String   @id @default("default")
  preset     String   @default("minimal")
  colors     Json
  fonts      Json
  radius     String
  darkMode   Boolean  @default(false)
  logoUrl    String?
  faviconUrl String?
  ogImageUrl String?
  customCss  String?
  updatedAt  DateTime @updatedAt

  @@map("branding")
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt

  @@map("feature_flag")
}

/// Integrări externe (plăți, curieri, facturare). `credentials` e criptat AES-256-GCM
/// cu APP_KEY și nu iese niciodată în clar din server.
model Integration {
  id                  String    @id @default(cuid())
  type                String
  provider            String
  credentials         String?
  config              Json      @default("{}")
  isActive            Boolean   @default(false)
  /// Faza 10, furnizori de plată reali: momentul în care o plată în mod test a fost confirmată printr-un IPN/callback cu
  /// semnătură validă. Fără el, trecerea în LIVE e refuzată pe server. Se șterge când se schimbă credențialele.
  verifiedInSandboxAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([type, provider])
  @@map("integration")
}

/// Jurnal DOAR DE ADĂUGARE: triggerele din migrația audit_log_append_only resping UPDATE/DELETE/TRUNCATE.
/// `actorId` nu e cheie străină: jurnalul trebuie să supraviețuiască ștergerii utilizatorului,
/// iar un ON DELETE SET NULL ar fi un UPDATE. `actorLabel` = emailul actorului la momentul acțiunii.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorLabel String?
  action     String
  entity     String
  entityId   String?
  before     Json?
  after      Json?
  requestId  String?
  /// "success" | "denied" | "failed" (constrângere CHECK în migrație)
  outcome    String   @default("success")
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// RBAC: permisiuni ca string-uri (ex. products.cost.view)
// ---------------------------------------------------------------------------

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  users       UserRole[]

  @@map("role")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role")
}

// ---------------------------------------------------------------------------
// Media (Faza 3): fișierele din biblioteca magazinului
// ---------------------------------------------------------------------------

/// Folder din biblioteca media. Arbore prin `parentId`; numele e unic în același părinte
/// (indecșii parțiali, fără diferență de majuscule, sunt în migrația media_library).
model MediaFolder {
  id        String        @id @default(cuid())
  name      String
  parentId  String?
  parent    MediaFolder?  @relation("MediaFolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  MediaFolder[] @relation("MediaFolderTree")
  media     Media[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([parentId])
  @@map("media_folder")
}

/// Un fișier din bibliotecă. `storageKey` = originalul FĂRĂ EXIF/GPS (păstrat pentru a
/// regenera variantele); `variants` = lista variantelor generate din job. Numele original
/// al fișierului e doar informativ în admin și nu apare niciodată într-un URL.
model Media {
  id                  String                    @id @default(cuid())
  /// "pending" | "processing" | "ready" | "failed" (constrângere CHECK în migrație)
  status              String                    @default("pending")
  mime                String
  sizeBytes           Int
  width               Int?
  height              Int?
  /// SHA-256 (hex) al originalului stocat; permite detectarea dublurilor
  checksum            String
  /// SHA-256 (hex) al adresei sursă normalizate, pentru imaginile aduse prin import din adresă (idempotență: aceeași
  /// adresă nu produce un al doilea fișier). `null` la fișierele încărcate de utilizator.
  sourceHash          String?                   @unique
  originalName        String
  storageKey          String                    @unique
  /// [{ name, format, key, width, height, sizeBytes }]
  variants            Json                      @default("[]")
  blurhash            String?
  alt                 String                    @default("")
  tags                String[]                  @default([])
  folderId            String?
  folder              MediaFolder?              @relation(fields: [folderId], references: [id], onDelete: Restrict)
  processingError     String?
  uploadedById        String?
  uploadedBy          User?                     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  productMedia        ProductMedia[]
  /// Folosit în descrierea bogată a unor produse (`<img data-media-id>`); FK Restrict, ca la `productMedia`
  productDescriptions ProductDescriptionMedia[]
  partsDiagrams       PartsDiagram[]
  categories          Category[]
  brands              Brand[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([folderId])
  @@index([status])
  @@index([checksum])
  @@index([createdAt])
  @@index([uploadedById])
  @@index([tags], type: Gin)
  @@map("media")
}

// ---------------------------------------------------------------------------
// Catalog (Faza 4): produse, variante, categorii, branduri, media pe produs
// ---------------------------------------------------------------------------

/// Brandul produselor (opțional pe produs; eMAG îl cere la publicare). `legacyId`/`legacyUrl` = identificatorul și
/// adresa din magazinul WooCommerce de unde se migrează (import repetabil + redirecționări 301 la lansare).
model Brand {
  id                  String    @id @default(cuid())
  slug                String    @unique
  name                String
  description         String?
  seoTitle            String?
  seoDescription      String?
  legacyId            String?   @unique
  legacyUrl           String?
  /// Termenul implicit „La comandă” (în zile) al produselor brandului care nu au unul propriu; gol = setarea globală
  defaultLeadTimeDays Int?
  /// Logoul din biblioteca media (FK Restrict + provider de utilizare media)
  logoMediaId         String?
  logoMedia           Media?    @relation(fields: [logoMediaId], references: [id], onDelete: Restrict)
  products            Product[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([logoMediaId])
  @@map("brand")
}

/// Categorie într-un arbore (`parentId`). `path` = calea de slug-uri (ex. `pompe/pompe-filtrare`),
/// `depth` = adâncimea (0 = rădăcină); ambele sunt calculate de serviciu, nu editate direct.
model Category {
  id                       String                   @id @default(cuid())
  parentId                 String?
  parent                   Category?                @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children                 Category[]               @relation("CategoryTree")
  slug                     String
  name                     String
  description              String?
  path                     String                   @unique
  depth                    Int                      @default(0)
  sortOrder                Int                      @default(0)
  /// Produsele din categorie costă prețul public pentru toate grupurile (`09` §1)
  excludeFromGroupDiscount Boolean                  @default(false)
  seoTitle                 String?
  seoDescription           String?
  legacyId                 String?                  @unique
  legacyUrl                String?
  /// Imaginea categoriei din biblioteca media (FK Restrict + provider de utilizare media)
  imageMediaId             String?
  imageMedia               Media?                   @relation(fields: [imageMediaId], references: [id], onDelete: Restrict)
  products                 ProductCategory[]
  channelMaps              ChannelCategoryMapping[]
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@index([parentId])
  @@index([imageMediaId])
  @@map("category")
}

/// Produsul vandabil. Prețurile, EAN-ul, garanția, greutatea și costul stau pe VARIANTĂ (un produs
/// simplu are o singură variantă implicită). `slug` e unic pe TOATE produsele, inclusiv cele șterse (index
/// `product_slug_key`, fără diferență de majuscule). `deletedAt` = soft delete.
model Product {
  id                       String                    @id @default(cuid())
  slug                     String
  title                    String
  subtitle                 String?
  description              String?
  /// "draft" | "active" | "archived" (CHECK în migrație)
  status                   String                    @default("draft")
  /// "physical" | "digital" (CHECK în migrație)
  type                     String                    @default("physical")
  /// Opțional: magazinul poate să nu folosească mărci. Obligatoriu doar la publicarea pe un canal care îl cere (eMAG).
  brandId                  String?
  brand                    Brand?                    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  /// Pregătit pentru cote reduse; nefolosit (vezi `TaxClass`). Calculul folosește `tax.standardRate`.
  taxClassId               String?
  taxClass                 TaxClass?                 @relation(fields: [taxClassId], references: [id], onDelete: Restrict)
  /// "standard" | "oversized" | "pallet" (CHECK în migrație). Regulile pe clase vin la Faza 12.
  shippingClass            String                    @default("standard")
  requiresInstallation     Boolean                   @default(false)
  /// Clasa energetică afișată înaintea finalizării comenzii: A+++ … G (CHECK în migrație)
  energyClass              String?
  /// Link către înregistrarea EPREL (https, CHECK în migrație)
  eprelUrl                 String?
  /// GPSR: producătorul produsului (nume, adresă și contact)
  gpsrManufacturerName     String?
  gpsrManufacturerContact  String?
  /// GPSR: persoana responsabilă din UE, dacă producătorul e din afara UE
  gpsrResponsibleName      String?
  gpsrResponsibleContact   String?
  /// GPSR: avertismente de siguranță și instrucțiuni
  safetyWarnings           String?
  /// Câmpuri pregătitoare (Faza 5 / Val 2), nefolosite încă
  expectedRestockDate      DateTime?
  allowBackorder           Boolean                   @default(false)
  /// Valoarea implicită vine din setarea `inventory.manageStock`; aici e suprascrierea per produs.
  manageStock              Boolean                   @default(true)
  /// "instock" | "outofstock" | "onbackorder" (CHECK); folosit când `manageStock = false`
  stockStatus              String                    @default("instock")
  /// Termenul „La comandă” în zile (0–365); gol = implicitul brandului, apoi setarea globală
  leadTimeDays             Int?
  /// Unitatea de măsură a produsului (D11); gol = bucată (pas 1). Varianta o poate suprascrie.
  measureUnitId            String?
  measureUnit              MeasureUnit?              @relation(fields: [measureUnitId], references: [id], onDelete: Restrict)
  /// La ce se referă `price` al variantelor: "unit" (preț pe unitate: lei/ml) | "step" (preț pe pas: lei/sac); CHECK
  priceBasis               String                    @default("unit")
  /// Pasul de vânzare în zecimi de miime de unitate (25000 = 2,5 ml); gol = o unitate. Cantitatea comandată e multiplu exact.
  saleStep                 Int?
  /// Denumirea pasului pentru afișarea prețului pe pas («sac», «rolă»); gol = fără denumire. 1–30 de caractere (CHECK)
  saleStepLabel            String?
  /// Minimul comandat, în pași (gol = 1)
  minSteps                 Int?
  /// Arată și prețul unui pas (ex. „Rola de 41,25 mp ≈ …”)
  showStepPrice            Boolean                   @default(false)
  excludeFromGroupDiscount Boolean                   @default(false)
  seoTitle                 String?
  seoDescription           String?
  publishedAt              DateTime?
  sortOrder                Int                       @default(0)
  metadata                 Json                      @default("{}")
  legacyId                 String?                   @unique
  legacyUrl                String?
  deletedAt                DateTime?
  variants                 ProductVariant[]
  freeShippingExclusion    FreeShippingExclusion?
  categories               ProductCategory[]
  media                    ProductMedia[]
  descriptionMedia         ProductDescriptionMedia[]
  options                  ProductOption[]
  attributes               AttributeValue[]
  collections              CollectionProduct[]
  relations                ProductRelation[]         @relation("ProductRelations")
  relatedTo                ProductRelation[]         @relation("RelatedProducts")
  importImages             ProductImportImage[]
  documents                ProductDocument[]
  channelListings          ChannelListing[]
  partsDiagrams            PartsDiagramProduct[]
  hotspots                 PartsDiagramHotspot[]
  /// Faza 14b: extensia 1:1 a produsului digital (conținutul, accesul) și drepturile de acces ale clienților.
  digital                  DigitalProduct?
  digitalEntitlements      DigitalEntitlement[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@index([brandId])
  @@index([taxClassId])
  @@index([status])
  @@index([deletedAt])
  @@map("product")
}

model ProductCategory {
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// O singură categorie primară per produs (index parțial în migrație)
  isPrimary  Boolean  @default(false)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_category")
}

/// Variantă vandabilă. Sumele sunt `int` în bani. `price` = BRUT (cu TVA inclus), `salePrice` = prețul
/// promoțional brut (în intervalul `saleStartsAt`–`saleEndsAt`, dacă sunt setate). `costPrice` = prețul de
/// achiziție NET (fără TVA), ⚠️ DOAR pentru admin (`products.cost.view`): niciodată în API public, props
/// către componente client, feed-uri, snapshot de comandă sau loguri.
model ProductVariant {
  id                     String               @id @default(cuid())
  productId              String
  product                Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                    String               @unique
  /// GTIN (8-14 cifre). Nu e NOT NULL în bază (draft-uri, import); obligatoriu la publicarea pe eMAG.
  ean                    String?
  /// Garanția în luni. Nu e NOT NULL în bază (valoarea implicită e o decizie de business); obligatorie la eMAG.
  warrantyMonths         Int?
  price                  Int
  salePrice              Int?
  saleStartsAt           DateTime?
  saleEndsAt             DateTime?
  costPrice              Int?
  costPriceDate          DateTime?
  /// Greutate în grame, dimensiuni în milimetri (întregi; transportul folosește max(real, volumetric))
  weightGrams            Int?
  lengthMm               Int?
  widthMm                Int?
  heightMm               Int?
  /// Suprascrierea per variantă a lui `Product.manageStock` (null = moștenește de la produs)
  manageStock            Boolean?
  /// "instock" | "outofstock" | "onbackorder" (CHECK); suprascrie `Product.stockStatus` (null = moștenește)
  stockStatus            String?
  /// Unitate, bază de preț, pas și minim: nul = moștenește de la produs (ca `manageStock`)
  measureUnitId          String?
  measureUnit            MeasureUnit?         @relation(fields: [measureUnitId], references: [id], onDelete: Restrict)
  priceBasis             String?
  saleStep               Int?
  minSteps               Int?
  /// Cum ține SmartBill stocul acestei variante: "same_unit" (aceeași unitate) | "steps" (1 bucată SmartBill = 1 pas)
  /// | "ratio" (1 unitate SmartBill = `smartbillRatio` zecimi de miime din unitatea noastră); gol = aceeași unitate
  smartbillMode          String?
  smartbillUnitName      String?
  smartbillRatio         Int?
  position               Int                  @default(0)
  isDefault              Boolean              @default(false)
  legacyId               String?              @unique
  media                  ProductMedia[]
  costHistory            CostPriceHistory[]
  priceHistory           PriceHistory[]
  /// Piese de schimb: codul și numele producătorului (căutare exactă pe cod; indexul trigram vine cu căutarea, Faza 7)
  manufacturerPartNumber String?
  manufacturerName       String?
  optionValues           VariantOptionValue[]
  channelListings        ChannelListing[]
  inventoryItems         InventoryItem[]
  stockMovements         StockMovement[]
  backInStockAlerts      BackInStockAlert[]
  cartItems              CartItem[]
  orderLines             OrderLine[]
  wishlistItems          WishlistItem[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  offerLines             OrderOfferLine[]

  @@unique([id, productId])
  @@index([productId])
  @@index([ean])
  @@map("product_variant")
}

/// Importul prețurilor de achiziție (NIR) din exportul SmartBill «mișcări produse» (Faza 15, docs/09 §4): previzualizare fără scriere,
/// confirmare, procesare în coadă, raport. `plan` = ce se aplică (câștigătorul fiecărui cod) și `report` = raportul complet.
/// ⚠️ Conțin prețuri de achiziție: DOAR admin, cu `products.cost.view`; nu se pun în audit sau în loguri. `status`: previewed | queued
/// | running | completed | failed (CHECK în migrație); `format`: csv | xls | xlsx. Previzualizarea expiră la `expiresAt`.
model NirImport {
  id             String    @id @default(cuid())
  createdById    String?
  createdBy      User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  status         String    @default("previewed")
  fileName       String
  format         String
  sizeBytes      Int
  /// SHA-256 (hex) al fișierului, pentru a recunoaște același fișier încărcat din nou
  fileHash       String
  /// Rândurile de date din fișier (fără goale și fără «Total»)
  rowCount       Int
  /// Câte variante se actualizează (câștigătorii cu dată mai nouă, la momentul previzualizării)
  itemCount      Int
  processedItems Int       @default(0)
  plan           Json
  report         Json
  errorMessage   String?
  expiresAt      DateTime
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([createdById])
  @@index([status])
  @@index([createdAt])
  @@map("nir_import")
}

/// Istoricul prețurilor de achiziție NET. ⚠️ DOAR admin, ca `ProductVariant.costPrice`.
model CostPriceHistory {
  id            String         @id @default(cuid())
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  costPrice     Int
  effectiveDate DateTime
  /// "manual" | "import" (CHECK în migrație)
  source        String
  importId      String?
  createdAt     DateTime       @default(now())

  @@index([variantId, effectiveDate])
  @@map("cost_price_history")
}

/// Prețul public brut în vigoare al unei variante de la `effectiveFrom` încolo (valoarea efectivă:
/// min(preț, promoție activă)). Sursa pentru „cel mai mic preț din ultimele 30 de zile” (Omnibus).
/// Se scrie la fiecare schimbare a prețului efectiv; vezi `lowestPriceInWindow` din `@ecom/core`.
model PriceHistory {
  id            String         @id @default(cuid())
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  price         Int
  effectiveFrom DateTime

  @@unique([variantId, effectiveFrom])
  @@map("price_history")
}

/// Fișier din bibliotecă atașat unui produs (sau unei variante a lui). `onDelete: Restrict` spre `Media`
/// e plasa de siguranță sub `ProductMediaUsageProvider`: un fișier folosit nu se poate șterge nici dacă
/// providerul nu e înregistrat. `position` 0 = imaginea principală.
model ProductMedia {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId, productId], references: [id, productId], onDelete: Cascade)
  mediaId   String
  media     Media           @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  position  Int             @default(0)
  createdAt DateTime        @default(now())

  @@index([productId, position])
  @@index([variantId])
  @@index([mediaId])
  @@map("product_media")
}

/// Fișierele din biblioteca media folosite în DESCRIEREA bogată a unui produs. Se ține în pas cu HTML-ul de către
/// serviciul de produse (la fiecare salvare); FK Restrict spre `Media`: un fișier folosit într-o descriere nu se poate șterge.
model ProductDescriptionMedia {
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@id([productId, mediaId])
  @@index([mediaId])
  @@map("product_description_media")
}

// ---------------------------------------------------------------------------
// Catalog (Faza 4, punctul 3): opțiuni, colecții, atribute, relații, clase de taxare
// ---------------------------------------------------------------------------

/// Opțiune de variantă (ex. „Mărime”, „Culoare”) a unui produs. Numele e unic per produs (fără
/// diferență de majuscule, index parțial în migrație).
model ProductOption {
  id        String               @id @default(cuid())
  productId String
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  position  Int                  @default(0)
  values    OptionValue[]
  variants  VariantOptionValue[]

  @@unique([id, productId])
  @@index([productId, position])
  @@map("product_option")
}

model OptionValue {
  id       String               @id @default(cuid())
  optionId String
  option   ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value    String
  position Int                  @default(0)
  variants VariantOptionValue[]

  @@unique([id, optionId])
  @@index([optionId, position])
  @@map("option_value")
}

/// Valoarea unei opțiuni pentru o variantă. Cheile compuse garantează în bază că varianta, opțiunea și
/// valoarea sunt ale aceluiași produs și că o variantă are cel mult o valoare per opțiune (PK).
model VariantOptionValue {
  variantId     String
  productId     String
  optionId      String
  optionValueId String
  variant       ProductVariant @relation(fields: [variantId, productId], references: [id, productId], onDelete: Cascade)
  option        ProductOption  @relation(fields: [optionId, productId], references: [id, productId], onDelete: Cascade)
  value         OptionValue    @relation(fields: [optionValueId, optionId], references: [id, optionId], onDelete: NoAction)

  @@id([variantId, optionId])
  @@index([optionValueId])
  @@map("variant_option_value")
}

/// Colecție de produse: `manual` (listă în `CollectionProduct`) sau `automated` (reguli în `rules`,
/// evaluate de storefront în Faza 7).
model Collection {
  id             String              @id @default(cuid())
  slug           String
  name           String
  description    String?
  /// "manual" | "automated" (CHECK în migrație)
  type           String              @default("manual")
  rules          Json                @default("{}")
  sortOrder      Int                 @default(0)
  seoTitle       String?
  seoDescription String?
  legacyId       String?             @unique
  products       CollectionProduct[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@map("collection")
}

model CollectionProduct {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  position     Int        @default(0)

  @@id([collectionId, productId])
  @@index([productId])
  @@map("collection_product")
}

/// Atribut tehnic. `type` = text | number | select | bool. Cele `number` au unitate de măsură (`unit`:
/// m³/h, kW, m³) și, dacă `isFilterable`, se filtrează pe interval (slider) în Faza 7; valorile se
/// stochează ca numere exacte (`numberValue`), nu ca text. `code` e cheia stabilă (import, filtre).
model Attribute {
  id           String            @id @default(cuid())
  code         String            @unique
  name         String
  /// "text" | "number" | "select" | "bool" (CHECK în migrație)
  type         String
  /// Doar la `number` (CHECK în migrație)
  unit         String?
  isFilterable Boolean           @default(false)
  sortOrder    Int               @default(0)
  options      AttributeOption[]
  values       AttributeValue[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("attribute")
}

/// Valoare permisă a unui atribut de tip `select`.
model AttributeOption {
  id          String           @id @default(cuid())
  attributeId String
  attribute   Attribute        @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  position    Int              @default(0)
  values      AttributeValue[]

  @@unique([id, attributeId])
  @@index([attributeId, position])
  @@map("attribute_option")
}

/// Valoarea unui atribut pe un produs. Exact UNA dintre `textValue`, `numberValue`, `boolValue`,
/// `optionId` e setată (CHECK), iar un trigger din migrație cere ca ea să corespundă tipului atributului.
/// `numberValue`: NUMERIC(18,4), exact (nu `float`).
model AttributeValue {
  id          String           @id @default(cuid())
  productId   String
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   Attribute        @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  textValue   String?
  numberValue Decimal?         @db.Decimal(18, 4)
  boolValue   Boolean?
  optionId    String?
  option      AttributeOption? @relation(fields: [optionId, attributeId], references: [id, attributeId], onDelete: Restrict)

  @@unique([productId, attributeId])
  @@index([attributeId, numberValue])
  @@index([attributeId, optionId])
  @@map("attribute_value")
}

/// Relație între produse. Sensul: `productId` e produsul „principal”, `relatedProductId` cel asociat:
/// `accessory` / `upsell` / `crosssell` / `similar` (ale produsului principal), `spare_part` (piesa de
/// schimb a produsului principal) și `compatible_with` (produsul principal e compatibil cu cel asociat).
model ProductRelation {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation("ProductRelations", fields: [productId], references: [id], onDelete: Cascade)
  relatedProductId String
  relatedProduct   Product  @relation("RelatedProducts", fields: [relatedProductId], references: [id], onDelete: Cascade)
  /// "similar" | "accessory" | "upsell" | "crosssell" | "spare_part" | "compatible_with" (CHECK)
  type             String
  position         Int      @default(0)
  createdAt        DateTime @default(now())

  @@unique([productId, relatedProductId, type])
  @@index([relatedProductId])
  @@map("product_relation")
}

/// Clasă de taxare, PREGĂTITĂ pentru cote reduse pe viitor. DECIZIE (utilizator, Faza 4): produsele
/// folosesc doar cota standard din setarea `tax.standardRate` (21%); `TaxClass`/`TaxRate` nu sunt
/// expuse în admin, nu schimbă calculul prețurilor și nu se seedează nicio cotă (nimic hardcodat).
model TaxClass {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  isDefault Boolean   @default(false)
  rates     TaxRate[]
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("tax_class")
}

/// Cota unei clase de taxare, în puncte de bază (`2100` = 21%), valabilă de la `validFrom`.
model TaxRate {
  id         String   @id @default(cuid())
  taxClassId String
  taxClass   TaxClass @relation(fields: [taxClassId], references: [id], onDelete: Cascade)
  rateBps    Int
  validFrom  DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([taxClassId, validFrom])
  @@map("tax_rate")
}

// ---------------------------------------------------------------------------
// Catalog (Faza 4, punctul 4): documente, fișe explodate, câmpuri de nișă și GPSR
// ---------------------------------------------------------------------------

/// Document al produsului (etichetă energetică, fișă tehnică, manual, declarație CE...), încărcat manual.
/// Fișierul stă în storage sub `storageKey` (nu în biblioteca de imagini: acolo intră doar imagini, iar
/// documentele sunt de obicei PDF). `showInTab` = apare în tabul „Descărcări” de pe pagina produsului.
model ProductDocument {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// "energy_label" | "product_sheet" | "manual" | "ce_declaration" | "datasheet" | "warranty" | "other" (CHECK)
  type         String
  title        String
  storageKey   String   @unique
  originalName String
  mime         String
  sizeBytes    Int
  /// Cod de limbă din două litere (ro, en)
  language     String   @default("ro")
  position     Int      @default(0)
  showInTab    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId, position])
  @@map("product_document")
}

/// Fișa explodată: entitate proprie, atașabilă la mai multe produse (o familie de pompe are aceeași fișă
/// pentru 6 modele). Imaginea e un fișier din bibliotecă (`mediaId`, cu provider de utilizare media).
model PartsDiagram {
  id        String                @id @default(cuid())
  title     String
  mediaId   String
  media     Media                 @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  products  PartsDiagramProduct[]
  hotspots  PartsDiagramHotspot[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([mediaId])
  @@map("parts_diagram")
}

model PartsDiagramProduct {
  diagramId String
  diagram   PartsDiagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([diagramId, productId])
  @@index([productId])
  @@map("parts_diagram_product")
}

/// Rândul numerotat al fișei (varianta A: tabel; `xBp`/`yBp` nule) și, în varianta B (Val 2), poziția
/// punctului pe imagine, în sutimi de procent (0 = marginea stângă/de sus, 10000 = dreapta/jos).
/// `productId` = piesa de schimb din catalog; `label` opțional, dacă diferă de numele produsului.
model PartsDiagramHotspot {
  id        String       @id @default(cuid())
  diagramId String
  diagram   PartsDiagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  number    Int
  xBp       Int?
  yBp       Int?
  /// Piesa din catalog. Nulă când produsul a fost șters definitiv: hotspot-ul rămâne în fișă (se
  /// vede ca „fără produs” în editor), nu dispare odată cu produsul.
  productId String?
  product   Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  label     String?

  @@unique([diagramId, number])
  @@index([productId])
  @@map("parts_diagram_hotspot")
}

// ---------------------------------------------------------------------------
// Canale de vânzare (Faza 4, punctul 5): web (implicit) și, mai târziu, eMAG
// ---------------------------------------------------------------------------

/// Canal de vânzare. `web` e creat de seed (sistem, nu se șterge). `config` conține DOAR setări
/// nesecrete; cheile API ale unui canal extern stau criptate în `Integration`, nu aici.
/// `requiresEan`/`requiresBrand`: canalul cere EAN pe variantă și brand pe produs LA PUBLICARE
/// (eMAG); în rest, ambele rămân opționale în catalog.
model SalesChannel {
  id            String                   @id @default(cuid())
  code          String                   @unique
  name          String
  isActive      Boolean                  @default(true)
  /// Canalul de sistem (`web`): nu se poate șterge (trigger în migrație)
  isSystem      Boolean                  @default(false)
  requiresEan   Boolean                  @default(false)
  requiresBrand Boolean                  @default(false)
  config        Json                     @default("{}")
  listings      ChannelListing[]
  categoryMaps  ChannelCategoryMapping[]
  orders        Order[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@map("sales_channel")
}

/// Oferta unei variante pe un canal. `price`/`salePrice`/`stock` sunt valorile specifice canalului
/// (nule = cele ale magazinului). Pentru canalul `web` nu se creează rânduri (oferta e catalogul însuși).
model ChannelListing {
  id                 String         @id @default(cuid())
  channelId          String
  channel            SalesChannel   @relation(fields: [channelId], references: [id], onDelete: Restrict)
  productId          String
  product            Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId          String
  variant            ProductVariant @relation(fields: [variantId, productId], references: [id, productId], onDelete: Cascade)
  /// ID-ul ofertei la canal (eMAG: id-ul ofertei)
  externalId         String?
  /// Identificatorul produsului în catalogul canalului (eMAG: part_number_key)
  externalProductKey String?
  /// "draft" | "pending" | "active" | "rejected" | "inactive" (CHECK în migrație)
  status             String         @default("draft")
  price              Int?
  salePrice          Int?
  stock              Int?
  /// Ce a respins canalul și de ce: [{ code, message, field? }]
  validationErrors   Json           @default("[]")
  lastSyncAt         DateTime?
  /// "ok" | "error" (CHECK în migrație)
  lastSyncStatus     String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([channelId, variantId])
  @@index([productId])
  @@index([channelId, status])
  @@map("channel_listing")
}

/// Maparea unei categorii proprii la categoria canalului și a atributelor la caracteristicile lui.
model ChannelCategoryMapping {
  id                 String       @id @default(cuid())
  channelId          String
  channel            SalesChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  categoryId         String
  category           Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  externalCategoryId String
  /// { "<codul atributului nostru>": "<caracteristica canalului>" }
  characteristicsMap Json         @default("{}")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([channelId, categoryId])
  @@index([categoryId])
  @@map("channel_category_mapping")
}

// ---------------------------------------------------------------------------
// Import de produse (Faza 4, punctul 14a)
// ---------------------------------------------------------------------------

/// Un import de produse dintr-un fișier CSV/XLSX, în pașii lui: încărcat → verificat (dry-run, fără
/// modificări în catalog) → aplicat (sincron sau în fundal). Fișierul stă privat în storage sub
/// `storageKey` (cheie generată de server) și se șterge după aplicare, la anulare sau la expirare.
/// `planHash` leagă aplicarea de ce a fost verificat. `summary` și `report` conțin doar numere, SKU-uri
/// și mesaje; niciodată prețul de achiziție sau conținutul câmpurilor lungi.
model ProductImport {
  id            String    @id @default(cuid())
  createdById   String?
  createdBy     User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  /// "uploaded" | "validated" | "queued" | "running" | "completed" | "failed" (CHECK în migrație)
  status        String    @default("uploaded")
  fileName      String
  /// "csv" | "xlsx" (CHECK în migrație)
  format        String
  sizeBytes     Int
  /// SHA-256 (hex) al fișierului stocat
  fileHash      String
  /// Cheia fișierului în storage privat; `null` după ștergerea lui
  storageKey    String?   @unique
  /// Delimitatorul ales la CSV
  delimiter     String?
  /// Câmpul fiecărei coloane (în ordine), salvat la verificare
  mapping       Json?
  planHash      String?
  rowCount      Int
  processedRows Int       @default(0)
  summary       Json?
  report        Json?
  errorMessage  String?
  expiresAt     DateTime
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  images ProductImportImage[]

  @@index([createdById])
  @@index([expiresAt])
  @@map("product_import")
}

/// O imagine de adus dintr-o adresă, în cadrul unui import WooCommerce (punctul 15b). Sarcinile se creează la
/// aplicare (după produse) și se execută în fundal: o imagine eșuată nu strică produsul și se reîncearcă la rulări
/// următoare. Adresa e cea NORMALIZATĂ (https, gazdă permisă); motivul eșecului e un COD stabil, niciodată IP-uri,
/// anteturi sau corpuri de răspuns.
model ProductImportImage {
  id         String        @id @default(cuid())
  importId   String
  import     ProductImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Rândul din fișier și SKU-ul, pentru raport
  row        Int
  sku        String
  /// "product" (coloana «Imagini», se atașează produsului) | "description" (din descriere, intră în HTML) (CHECK în migrație)
  kind       String        @default("product")
  /// Ordinea în fișier, în cadrul produsului (prima = principală dacă produsul nu are imagini)
  position   Int
  sourceUrl  String
  sourceHash String
  host       String
  /// "pending" | "downloaded" | "existing" | "failed" (CHECK în migrație)
  status     String        @default("pending")
  /// Cod stabil al motivului (ex. host_not_allowed, too_large, not_image); null când n-a eșuat
  reason     String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([importId, status])
  @@index([productId])
  @@map("product_import_image")
}

// ---------------------------------------------------------------------------
// Stoc (Faza 5): unități de măsură, depozite, stoc, mișcări, rezervări, angajări, alerte
// Toate cantitățile sunt ÎNTREGI în zecimi de miime de unitate (4 zecimale; 25000 = 2,5): BIGINT pentru stoc,
// INT pentru pas și rapoarte de conversie. Niciun `float`. Modulul `Quantity` din `@ecom/shared` e singura aritmetică.
// ---------------------------------------------------------------------------

/// Unitate de măsură a vânzării și a stocului (buc, ml, mp, kg …). `decimals` = câte zecimale are voie cantitatea
/// (0–4). `smartbillName` = cum se numește unitatea în SmartBill. Unitățile de sistem nu se șterg; una folosită nici atât.
model MeasureUnit {
  id            String           @id @default(cuid())
  code          String           @unique
  name          String
  symbol        String
  smartbillName String?
  decimals      Int              @default(0)
  isActive      Boolean          @default(true)
  isSystem      Boolean          @default(false)
  sortOrder     Int              @default(0)
  products      Product[]
  variants      ProductVariant[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("measure_unit")
}

/// Locația stocului. Interfața arată o singură locație („Depozit principal”, redenumibilă); modelul multi-depozit
/// rămâne în bază, în spatele flag-ului `multiWarehouse`. Exact un depozit implicit (index parțial unic în migrație).
model Warehouse {
  id        String          @id @default(cuid())
  code      String          @unique
  name      String
  isDefault Boolean         @default(false)
  isActive  Boolean         @default(true)
  items     InventoryItem[]
  movements StockMovement[]
  snapshots StockSnapshot[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("warehouse")
}

/// Stocul unei variante gestionate într-un depozit. `physical` = cantitatea fizică din ultima poză SmartBill (plus
/// ajustările de după ea), valabilă la `physicalAsOf`; `committed` = „angajat” (comenzi confirmate, încă neoglindite în
/// poză); `reserved` = ținut pentru plăți în curs. Disponibil = physical − committed − reserved (niciodată sub 0).
/// ZERO rânduri pentru produsele cu `manageStock = false`. Toate cantitățile ≥ 0 (D5), garantat de CHECK.
model InventoryItem {
  id            String             @id @default(cuid())
  variantId     String
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouseId   String
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  physical      BigInt             @default(0)
  physicalAsOf  DateTime?
  committed     BigInt             @default(0)
  reserved      BigInt             @default(0)
  /// Tamponul de siguranță (în unitatea variantei): cantitatea ținută în rezervă la calculul disponibilului
  safetyBuffer  BigInt             @default(0)
  /// Pragul „stoc mic” în PAȘI; gol = setarea globală `inventory.lowStockSteps`
  lowStockSteps Int?
  reservations  StockReservation[]
  commitments   StockCommitment[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([variantId, warehouseId])
  @@index([warehouseId])
  @@map("inventory_item")
}

/// „Poza” periodică a stocului din SmartBill (import acum, API mai târziu): data valabilității, fișierul, numărul de
/// rânduri și raportul. Se aplică toată sau deloc. `actorId` nu e cheie străină (istoricul supraviețuiește utilizatorului).
model StockSnapshot {
  id          String          @id @default(cuid())
  warehouseId String
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  /// Ora la care e valabilă poza (nu ora încărcării)
  takenAt     DateTime
  /// "import" | "api" (CHECK)
  source      String
  fileName    String?
  fileHash    String?
  rowCount    Int             @default(0)
  actorId     String?
  actorLabel  String?
  report      Json            @default("{}")
  movements   StockMovement[]
  createdAt   DateTime        @default(now())

  @@index([warehouseId, takenAt])
  @@map("stock_snapshot")
}

/// Registru IMUABIL al schimbărilor de stoc (trigger: nicio modificare, ștergere sau golire). `effectiveAt` = ora
/// efectivă a faptului (regula „poza înlocuiește ajustările dinainte”), `createdAt` = ora scrierii. Referința
/// generică (`refType`, `refId`) leagă mișcarea de o comandă fără a depinde de tabela `Order`. Nu are chei străine
/// spre utilizator (istoricul supraviețuiește conturilor) și blochează ștergerea definitivă a variantei.
model StockMovement {
  id             String         @id @default(cuid())
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouseId    String
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  /// "adjustment" | "snapshot" | "commit" | "release" | "mirror" | "transfer_in" | "transfer_out" (CHECK)
  kind           String
  /// Motiv fix, obligatoriu la ajustări: "sale_in_store" | "receipt" | "return" | "inventory_correction" | "damaged"
  /// | "lost_stolen" | "other" (CHECK)
  reason         String?
  /// Text liber, obligatoriu la ajustări
  note           String?
  deltaPhysical  BigInt         @default(0)
  deltaCommitted BigInt         @default(0)
  physicalAfter  BigInt
  committedAfter BigInt
  effectiveAt    DateTime       @default(now())
  refType        String?
  refId          String?
  snapshotId     String?
  snapshot       StockSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  actorId        String?
  actorLabel     String?
  createdAt      DateTime       @default(now())

  @@index([variantId, effectiveAt])
  @@index([warehouseId, effectiveAt])
  @@index([refType, refId])
  @@index([snapshotId])
  @@map("stock_movement")
}

/// Rezervare pentru o plată în curs (card: 15 minute; transfer bancar: zile lucrătoare). Coșul NU rezervă.
/// O singură rezervare activă sau confirmată per referință și linie (index parțial unic în migrație).
/// Stări: "active" | "confirmed" | "released" | "expired" (CHECK, cu momentele coerente).
model StockReservation {
  id          String        @id @default(cuid())
  variantId   String
  warehouseId String
  item        InventoryItem @relation(fields: [variantId, warehouseId], references: [variantId, warehouseId], onDelete: Restrict)
  quantity    BigInt
  status      String        @default("active")
  refType     String
  refId       String
  /// Faza 9: cheie străină spre comandă. Setat DOAR când `refType = 'order'` (atunci `orderId = refId`; CHECK în migrație);
  /// celelalte tipuri de referință (ex. teste) rămân generice și au `orderId` nul.
  orderId     String?
  order       Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  expiresAt   DateTime
  confirmedAt DateTime?
  releasedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orderId])
  @@index([status, expiresAt])
  @@index([variantId, warehouseId, status])
  @@index([refType, refId])
  @@map("stock_reservation")
}

/// „Angajat”: cantitate dintr-o comandă confirmată, încă neoglindită în poza SmartBill (D1). Referință generică
/// (tip + id) în locul unei chei străine spre `Order` (tabela apare în Faza 9, unde se înlocuiește cu cheie străină,
/// cu validarea datelor existente). Unic per comandă și linie: aceeași comandă nu poate angaja de două ori, nici
/// după eliberare. `invoicedAt` = ora facturii (se compară cu ora pozei). Stări: "open" | "mirrored" | "released".
model StockCommitment {
  id          String        @id @default(cuid())
  variantId   String
  warehouseId String
  item        InventoryItem @relation(fields: [variantId, warehouseId], references: [variantId, warehouseId], onDelete: Restrict)
  quantity    BigInt
  status      String        @default("open")
  refType     String
  refId       String
  /// Faza 9: cheie străină spre comandă (vezi `StockReservation.orderId`).
  orderId     String?
  order       Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  committedAt DateTime      @default(now())
  invoicedAt  DateTime?
  mirroredAt  DateTime?
  releasedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([refType, refId, variantId, warehouseId], map: "stock_commitment_ref_key")
  @@index([orderId])
  @@index([variantId, warehouseId, status])
  @@map("stock_commitment")
}

/// „Anunță-mă când revine”: adresa se păstrează doar până la trimiterea unică (apoi se șterge) sau o perioadă
/// limitată (`inventory.backInStockRetentionDays`). O cerere în așteptare per variantă și adresă (index parțial).
model BackInStockAlert {
  id         String         @id @default(cuid())
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  email      String
  notifiedAt DateTime?
  createdAt  DateTime       @default(now())

  @@index([variantId, notifiedAt])
  @@map("back_in_stock_alert")
}

/// Istoric de adrese (Faza 7, C-43): când se schimbă slugul unui produs sau al unui brand, ori calea unei categorii (redenumire,
/// mutare, inclusiv descendenții), adresa veche rămâne aici și vitrina o redirecționează permanent (301) către adresa curentă a
/// aceleiași entități. `oldKey` e slugul (produs, brand) sau calea de slug-uri (categorie), în litere mici. `targetId` nu e cheie
/// străină (legătură polimorfă): vitrina verifică la citire că ținta există încă. Nu are lanțuri: pointează mereu spre entitate.
model SlugRedirect {
  id        String   @id @default(cuid())
  /// "product" | "category" | "brand" (CHECK în migrație)
  kind      String
  oldKey    String
  targetId  String
  createdAt DateTime @default(now())

  @@unique([kind, oldKey])
  @@index([kind, targetId])
  @@map("slug_redirect")
}

/// Coșul (Faza 8). Aparține fie unui utilizator autentificat (`userId`), fie unui oaspete (`tokenHash`): EXACT unul dintre ele
/// (CHECK în migrație, cu comparații explicite `IS NULL` / `IS NOT NULL`). Un utilizator are cel mult un coș. Coșul NU rezervă
/// stoc (D4) și nu păstrează prețuri: prețul, starea de stoc și totalul se recalculează la fiecare afișare, pe server.
model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 (hex) al tokenului din cookie; tokenul în sine nu se păstrează niciodată în baza de date.
  tokenHash String?    @unique
  /// După această dată coșul e șters de jobul de curățare; fiecare modificare o prelungește.
  expiresAt DateTime
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([expiresAt])
  @@map("cart")
}

/// O linie de coș: varianta și cantitatea (`Quantity`, zecimi de miime), nimic altceva despre bani. `ackedUnitPriceMinor` e
/// prețul unitar efectiv (bani, pe baza produsului) pe care l-a văzut clientul la ultima confirmare: dacă prețul curent diferă,
/// linia arată un mesaj până când clientul îl confirmă sau modifică cantitatea (totalul nu se schimbă tăcut).
model CartItem {
  id                  String         @id @default(cuid())
  cartId              String
  cart                Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId           String
  variant             ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /// Zecimi de miime de unitate; > 0 și cel mult MAX_QUANTITY (CHECK în migrație)
  quantity            BigInt
  ackedUnitPriceMinor Int?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_item")
}

// ---------------------------------------------------------------------------------------------------------------------
// Faza 9: checkout și comenzi. Sumele sunt întregi în bani (`...Minor`), niciodată float. Comanda e un snapshot imuabil:
// nicio cale din aplicație nu modifică liniile, adresele sau sumele după plasare (doar starea, prin state machine, iar
// evenimentele se adaugă). `costPrice` nu apare nicăieri aici.
// ---------------------------------------------------------------------------------------------------------------------

/// Nomenclatorul SIRUTA (INS, CC BY 4.0; `docs/SIRUTA-SURSA.md`): județe (nivel 1), UAT-uri (nivel 2), localități și sectoare
/// (nivel 3). Rândurile dispărute dintr-o versiune nouă se marchează `isActive = false`, nu se șterg (adresele păstrează codul).
/// Numele e cel din registru (majuscule, diacritice normalizate, pentru căutare); numele de afișare se calculează la citire.
model SirutaUnit {
  code                    Int               @id
  countyCode              Int
  name                    String
  parentCode              Int?
  parent                  SirutaUnit?       @relation("SirutaTree", fields: [parentCode], references: [code], onDelete: Restrict)
  children                SirutaUnit[]      @relation("SirutaTree")
  tip                     Int
  level                   Int
  isActive                Boolean           @default(true)
  sourceVersion           String
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  countyOf                Address[]         @relation("AddressCounty")
  localityOf              Address[]         @relation("AddressLocality")
  customerAddressCounty   CustomerAddress[] @relation("CustomerAddressCounty")
  customerAddressLocality CustomerAddress[] @relation("CustomerAddressLocality")

  @@index([countyCode, level])
  @@index([parentCode])
  @@map("siruta_unit")
}

/// Contorul numerelor de comandă: un singur rând, blocat în aceeași tranzacție cu plasarea (fără goluri; NU secvență Postgres,
/// care sare valori la rollback). Numărul = prefix (`checkout.orderNumberPrefix`) + contor cu zerouri la stânga.
model OrderCounter {
  id        String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("order_counter")
}

/// Comanda (Faza 9: doar oaspete, `customerId` gol; plata: ramburs sau transfer bancar). Trei statusuri separate, cu tranziții
/// validate de state machine (`packages/core/src/orders`); valorile sunt păzite de CHECK în migrație.
model Order {
  id                     String               @id @default(cuid())
  number                 String               @unique
  channelId              String
  channel                SalesChannel         @relation(fields: [channelId], references: [id], onDelete: Restrict)
  externalId             String?
  /// JSON brut de la canalul extern (eMAG), pentru depanare; nul la comenzile web.
  externalData           Json?
  parentSubscriptionId   String?
  /// Gol în Faza 9 (checkout doar pentru oaspete); contul de client vine în Faza 14.
  customerId             String?
  email                  String
  phone                  String
  currency               String               @default("RON")
  /// pending | confirmed | processing | completed | cancelled | returned | draft
  status                 String               @default("pending")
  /// pending | authorized | paid | partially_refunded | refunded | failed | cancelled | chargeback
  paymentStatus          String               @default("pending")
  /// unfulfilled | partially_fulfilled | fulfilled | in_transit | delivered | returned | cancelled
  fulfillmentStatus      String               @default("unfulfilled")
  subtotalMinor          Int
  discountMinor          Int                  @default(0)
  shippingMinor          Int
  codFeeMinor            Int                  @default(0)
  /// TVA extras din transport și din taxa de ramburs (sume cu TVA inclus, ca liniile; docs/09 §2).
  shippingTaxMinor       Int                  @default(0)
  codFeeTaxMinor         Int                  @default(0)
  /// TVA total = suma TVA pe linii + shippingTaxMinor + codFeeTaxMinor (verificat în bază, la commit).
  taxMinor               Int
  totalMinor             Int
  /// Cota standard de TVA la plasare, în puncte de bază (2100 = 21%), ca snapshot.
  taxRateBps             Int
  groupPricingType       String               @default("none")
  /// Faza 15: grupul clientului la plasare (snapshot): id-ul, procentul și avantajul acordat (prețul public curent minus ce a plătit,
  /// în bani). Avantajul e calculat de motor și NU conține costul. Nu se recalculează după plasare.
  customerGroupId        String?
  customerGroup          CustomerGroup?       @relation(fields: [customerGroupId], references: [id], onDelete: Restrict)
  groupDiscountBps       Int?
  groupMarkupBps         Int?
  groupAdvantageMinor    Int                  @default(0)
  /// Faza 15b: instantaneul punctelor de loialitate la plasare. `discountMinor` conține valoarea punctelor folosite.
  loyaltyCustomerId      String?
  loyaltyPointsUsed      Int                  @default(0)
  loyaltyPointValueMinor Int?
  loyaltyVatMode         String?
  /// Rata de acumulare la plasare (bani pentru 1 punct); gol = comanda nu aduce puncte (oaspete, partener, program oprit).
  loyaltyEarnRateMinor   Int?
  loyaltyPointsToEarn    Int?
  /// De când pot fi acordate punctele (sfârșitul ferestrei de retur); gol cât timp comanda nu e livrată.
  loyaltyEarnDueAt       DateTime?
  loyaltyGrantedAt       DateTime?
  /// Metoda de livrare aleasă: cod (courier | pickup | …) și snapshot-ul ofertei (curier, serviciu, preț, zile, sursa).
  shippingMethodCode     String
  shippingSnapshot       Json
  /// cod | bank_transfer | card (Faza 10)
  paymentMethod          String
  customerNote           String?
  adminNote              String?
  installationRequested  Boolean              @default(false)
  installationNote       String?
  /// Starea de urmărire a cererii de instalare (docs/15 §4): requested | contacted | scheduled | done | declined; nulă dacă nu s-a
  /// cerut instalare (CHECK în migrație). Schimbările scriu OrderEvent și audit.
  installationStatus     String?
  installationStatusAt   DateTime?
  /// Consimțământul pentru Termeni: textul exact, versiunea și momentul. Fără IP și fără user-agent (decizie Faza 9).
  termsAcceptedAt        DateTime
  termsConsentText       String
  termsConsentVersion    String
  /// Transfer bancar: până când ține rezervarea; la expirare comanda se anulează automat. Card (Faza 10): sfârșitul
  /// rezervării curente (15 minute de la ultima inițiere a plății).
  reservationExpiresAt   DateTime?
  /// Card (Faza 10): sfârșitul ferestrei de reîncercare a plății (24 h de la plasare); la expirare comanda se anulează
  /// automat. Nul la ramburs și transfer.
  paymentRetryDeadlineAt DateTime?
  /// Cheia de idempotență a plasării (protecție la dublu-click): aceeași cheie întoarce aceeași comandă.
  idempotencyKey         String               @unique
  source                 String               @default("web")
  placedAt               DateTime             @default(now())
  confirmedAt            DateTime?
  cancelledAt            DateTime?
  /// Marcajul «La furnizor» (Faza 11, decizia 2026-11-19): NU e stare și nu atinge stocul, banii sau statusurile. Toate nule
  /// (nemarcată) sau `supplierMarkedAt` + `supplierMarkedBy` setate (CHECK în migrație); furnizorul și nota sunt text liber.
  supplierMarkedAt       DateTime?
  supplierMarkedBy       String?
  supplierName           String?
  supplierNote           String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  lines                  OrderLine[]
  events                 OrderEvent[]
  payments               Payment[]
  addresses              Address[]
  stockReservations      StockReservation[]
  stockCommitments       StockCommitment[]
  refunds                Refund[]
  paymentRetryTokens     PaymentRetryToken[]
  emailDispatches        EmailDispatch[]
  notes                  OrderNote[]
  offer                  OrderOffer?
  shipments              Shipment[]
  invoices               Invoice[]
  returns                ReturnRequest[]
  digitalEntitlements    DigitalEntitlement[]
  /// Faza 14b: bifa de renunțare la dreptul de retragere (doar la comenzile cu linii digitale): momentul, textul EXACT și versiunea
  /// textului acceptat, separate de Termeni. Toate trei nule sau toate trei setate (CHECK în migrație).
  digitalConsentAt       DateTime?
  digitalConsentText     String?
  digitalConsentVersion  String?

  @@index([status, paymentStatus])
  @@index([email])
  @@index([reservationExpiresAt])
  @@index([channelId])
  @@index([placedAt])
  @@index([supplierMarkedAt])
  @@index([installationStatus])
  @@index([loyaltyCustomerId])
  @@index([loyaltyEarnDueAt])
  @@map("customer_order")
}

/// O linie de comandă: snapshot imuabil (preț, TVA, cantitate). `productSnapshot` NU conține `costPrice`. `lineTotalMinor` e suma
/// rotunjită O SINGURĂ DATĂ pe linie; `netMinor + taxMinor = lineTotalMinor` (CHECK).
model OrderLine {
  id                 String              @id @default(cuid())
  orderId            String
  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId          String?
  variant            ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sku                String
  title              String
  variantTitle       String?
  imageUrl           String?
  /// Zecimi de miime de unitate (`Quantity`), > 0.
  quantity           BigInt
  unitSymbol         String
  unitDecimals       Int
  unitPriceMinor     Int
  discountMinor      Int                 @default(0)
  lineTotalMinor     Int
  netMinor           Int
  taxMinor           Int
  taxRateBps         Int
  /// Starea de stoc la plasare: in_stock | limited | on_order (D6) și termenul, în zile, la «La comandă».
  stockState         String
  leadTimeDays       Int?
  /// Clasa de transport la plasare (standard | oversized | pallet), pentru reguli (easybox) și transport.
  shippingClass      String
  productSnapshot    Json
  /// Faza 14b: linia e un produs digital (fără transport, fără stoc, fără retur din cont); scris la plasare, imuabil în practică.
  isDigital          Boolean             @default(false)
  /// Faza 15b: partea de reducere din puncte a liniei, în bani; `lineTotalMinor` rămâne valoarea dinaintea punctelor.
  loyaltyDiscountMinor Int                 @default(0)
  /// Linia contează la acumularea de puncte (la plasare: produsele la promoție pot fi excluse din setări).
  loyaltyEarnEligible  Boolean             @default(true)
  createdAt          DateTime            @default(now())
  returnItems        ReturnItem[]
  digitalEntitlement DigitalEntitlement?

  @@unique([orderId, variantId])
  @@index([variantId])
  @@map("order_line")
}

/// Jurnalul comenzii (timeline). Se adaugă, nu se modifică: nicio cale din aplicație nu face update sau delete.
model OrderEvent {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       String
  message    String
  data       Json?
  /// Cine a făcut acțiunea (admin); gol la evenimentele clientului sau ale sistemului.
  actorLabel String?
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("order_event")
}

/// Expedierea unei comenzi (Faza 12): un AWB. `mode`: provider (creat prin API la un curier: wootPRO, Sameday, DEMO) | manual
/// (transport paletizat: adminul introduce transportatorul și numărul). `kind`: outbound | return (AWB de retur, cu `parentId`).
/// `status`: created | picked_up | in_transit | delivered | returned | cancelled. Comenzile cu ridicare personală NU au expedieri.
/// Cel mult o expediere outbound neanulată pe comandă și cel mult un retur neanulat pe expediere (indecși parțiali în migrație).
model Shipment {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  kind           String          @default("outbound")
  mode           String
  provider       String?
  carrier        String
  awb            String
  trackingUrl    String?
  providerRef    String?
  status         String          @default("created")
  statusDetail   String?
  /// Rambursul transmis curierului (bani); 0 dacă nu e ramburs.
  codAmountMinor Int             @default(0)
  parcelCount    Int             @default(1)
  weightGrams    Int?
  parentId       String?
  parent         Shipment?       @relation("ShipmentReturn", fields: [parentId], references: [id], onDelete: Restrict)
  returns        Shipment[]      @relation("ShipmentReturn")
  creatorLabel   String?
  lastSyncedAt   DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  events         ShipmentEvent[]

  @@unique([provider, awb])
  @@index([orderId])
  @@index([status, lastSyncedAt])
  @@map("shipment")
}

/// Evenimentele de urmărire ale unei expedieri (de la curier). `eventKey` face sincronizarea idempotentă: același eveniment
/// primit de două ori (job, webhook) se scrie o singură dată.
model ShipmentEvent {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  eventKey   String
  code       String
  label      String
  occurredAt DateTime
  createdAt  DateTime @default(now())

  @@unique([shipmentId, eventKey])
  @@index([shipmentId, occurredAt])
  @@map("shipment_event")
}

/// Plata unei comenzi = O TENTATIVĂ de plată (la card, o comandă are mai multe, `attemptNo` 1, 2, …). `provider`: cod |
/// bank_transfer | netopia | euplatesc | demo. `status`: pending | paid | failed | cancelled | refunded. Sumele sunt bani
/// întregi; `capturedAmountMinor` e suma confirmată de procesator (trebuie să fie egală cu `amountMinor`, altfel plata
/// intră în «necesită atenție»). `refundCommittedMinor` = suma angajată în rambursări (cerute, confirmate sau manuale),
/// plafonată de `amountMinor` și în bază. Niciodată PAN, CVV sau date complete de card: doar ultimele 4 cifre, dacă le trimite
/// procesatorul. `rawPayload` nu conține secrete.
model Payment {
  id                   String                @id @default(cuid())
  orderId              String
  order                Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider             String
  method               String
  amountMinor          Int
  currency             String                @default("RON")
  status               String                @default("pending")
  providerRef          String?
  idempotencyKey       String?               @unique
  rawPayload           Json?
  capturedAt           DateTime?
  /// Faza 10: tentativa (1, 2, …), modul (test | live | demo; nul la ramburs și transfer), ultimele 4 cifre ale cardului,
  /// suma și moneda confirmate de procesator, suma angajată în rambursări.
  attemptNo            Int                   @default(1)
  mode                 String?
  cardLast4            String?
  capturedAmountMinor  Int?
  capturedCurrency     String?
  refundCommittedMinor Int                   @default(0)
  failureCode          String?
  /// «Necesită atenție»: motivul (cod stabil), momentul și rezolvarea.
  attentionReason      String?
  attentionAt          DateTime?
  attentionResolvedAt  DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  refunds              Refund[]
  webhookEvents        PaymentWebhookEvent[]

  @@unique([orderId, attemptNo])
  @@unique([provider, providerRef])
  @@index([orderId])
  @@index([status, createdAt])
  @@index([attentionAt])
  @@map("payment")
}

/// Rambursarea unei plăți (Faza 10). `status`: requested | confirmed | failed | manual_required. Idempotentă prin
/// `idempotencyKey` (la rambursările automate derivată din plată: o singură rambursare per plată și motiv).
model Refund {
  id               String          @id @default(cuid())
  paymentId        String
  payment          Payment         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  amountMinor      Int
  reason           String
  /// admin | auto_stock_lost | auto_late_payment
  kind             String
  status           String          @default("requested")
  providerRef      String?
  idempotencyKey   String          @unique
  actorLabel       String?
  failureMessage   String?
  /// «Am rambursat manual»: referința din contul procesatorului.
  manualReference  String?
  resolvedManually Boolean         @default(false)
  returnRequests   ReturnRequest[]
  /// Faza 11 (decizia 2026-11-19): rambursarea a fost cerută de un actor CU LIMITĂ (rolul Suport: `orders.refund` fără
  /// `payments.refund`). Limita se aplică pe suma acestor rambursări pe comandă, sub blocare.
  limitedActor     Boolean         @default(false)
  /// Momentul în care cererea a fost TRIMISĂ procesatorului. O cerere trimisă și rămasă fără rezultat nu se retrimite automat
  /// (risc de rambursare dublă): devine «manual_required».
  sentAt           DateTime?
  confirmedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([paymentId])
  @@index([orderId])
  @@index([status, createdAt])
  @@map("refund")
}

/// Evenimentele webhook/IPN primite de la procesatori: unicitate pe (furnizor, eventId) = idempotență. `status`: received |
/// processed | failed | rejected. Un eveniment RESPINS (semnătură invalidă) păstrează doar motivul și hash-ul corpului, fără
/// conținut și fără date personale. `normalized` conține doar câmpurile verificate și nesensibile.
model PaymentWebhookEvent {
  id           String    @id @default(cuid())
  provider     String
  eventId      String
  status       String    @default("received")
  rejectReason String?
  bodyHash     String
  paymentId    String?
  payment      Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  normalized   Json?
  attempts     Int       @default(0)
  lastError    String?
  receivedAt   DateTime  @default(now())
  processedAt  DateTime?

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@index([paymentId])
  @@map("payment_webhook_event")
}

/// Notificările interne ale adminului (Faza 11): persistente, fără date personale în titlu, vizibile după `permission`. `dedupKey`
/// face ca aceeași situație să producă o singură notificare. Citit/necitit se ține per utilizator în `AdminNotificationRead`.
model AdminNotification {
  id         String                  @id @default(cuid())
  kind       String
  title      String
  /// Linie scurtă de context sub titlu (numărul comenzii sau al ofertei și un motiv), fără date personale; `NULL` la cele vechi.
  context    String?
  href       String
  permission String
  dedupKey   String                  @unique
  createdAt  DateTime                @default(now())
  reads      AdminNotificationRead[]

  @@index([createdAt])
  @@map("admin_notification")
}

model AdminNotificationRead {
  notificationId String
  notification   AdminNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime          @default(now())

  @@id([notificationId, userId])
  @@index([userId])
  @@map("admin_notification_read")
}

/// Vederile salvate ale listei de comenzi (Faza 11), proprii fiecărui utilizator: numele și șirul de interogare al filtrelor.
model OrderSavedView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  query     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, createdAt])
  @@map("order_saved_view")
}

/// Oferta de plată (Faza 11, decizia A din 2026-11-20): liniile și totalurile ÎNGHEȚATE la creare, calculate de motorul de prețuri
/// printr-un coș al adminului. Clientul o plătește printr-un link cu jeton aleatoriu de 256 de biți (în bază stă doar amprenta SHA-256).
/// La plată serverul recalculează: dacă prețul, transportul, TVA-ul sau stocul diferă, oferta devine `stale`; altfel devine comandă
/// reală prin `CheckoutService` (`convertedOrderId` UNIC: o singură comandă). `status`: active | converted | expired | stale | cancelled.
model OrderOffer {
  id                String            @id @default(cuid())
  number            String            @unique
  status            String            @default("active")
  tokenHash         String            @unique
  expiresAt         DateTime
  creatorId         String
  creatorLabel      String
  email             String
  phone             String
  /// Adresa clientului (cod județ/localitate SIRUTA, stradă etc.), validată cu aceeași schemă ca la checkout.
  shipping          Json
  billing           Json?
  company           Json?
  shippingOfferCode String
  /// courier | pickup
  shippingKind      String
  subtotalMinor     Int
  shippingMinor     Int
  taxMinor          Int
  totalMinor        Int
  taxRateBps        Int
  convertedOrderId  String?           @unique
  convertedOrder    Order?            @relation(fields: [convertedOrderId], references: [id], onDelete: Restrict)
  convertedAt       DateTime?
  staleReason       String?
  staleAt           DateTime?
  cancelledAt       DateTime?
  lastSentAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  lines             OrderOfferLine[]
  events            OrderOfferEvent[]

  @@index([status, expiresAt])
  @@index([createdAt])
  @@map("order_offer")
}

model OrderOfferLine {
  id             String          @id @default(cuid())
  offerId        String
  offer          OrderOffer      @relation(fields: [offerId], references: [id], onDelete: Cascade)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sku            String
  title          String
  variantTitle   String?
  /// Zecimi de miime de unitate (`Quantity`), > 0.
  quantity       BigInt
  unitSymbol     String
  unitPriceMinor Int
  lineTotalMinor Int
  vatMinor       Int
  /// in_stock | limited | on_order
  state          String
  leadTimeDays   Int?
  position       Int

  @@unique([offerId, position])
  @@index([variantId])
  @@map("order_offer_line")
}

model OrderOfferEvent {
  id         String     @id @default(cuid())
  offerId    String
  offer      OrderOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  type       String
  message    String
  data       Json?
  actorLabel String?
  createdAt  DateTime   @default(now())

  @@index([offerId, createdAt])
  @@map("order_offer_event")
}

model OrderOfferCounter {
  id        String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("order_offer_counter")
}

/// Notele interne ale comenzii (Faza 11): text liber al echipei, cu autor și moment. Doar se adaugă. Textul poate conține date
/// personale: nu intră în `OrderEvent` (evenimentul spune doar că s-a adăugat o notă) și nu se loghează.
model OrderNote {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorLabel String
  body        String
  createdAt   DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("order_note")
}

/// Un email tranzacțional de trimis (Faza 11), în stil «outbox»: rândul se scrie ÎN ACEEAȘI tranzacție cu evenimentul care îl
/// declanșează (OrderEvent), iar trimiterea o face workerul, prin coada «emails». Unicitatea `(eventKey, template, recipient)` e
/// garanția «o singură dată per eveniment», în bază, nu în memorie: același eveniment procesat de două ori (retry, webhook
/// repetat, două workere) dă UN singur rând. «Retrimite» e o acțiune separată, cu `eventKey` propriu (`resend:…`).
/// `status`: queued | sending | sent | failed (dead-letter, vizibil în admin) | skipped. O trimitere rămasă «sending» fără
/// rezultat NU se retrimite automat (risc de email dublu): devine «failed» și se retrimite doar din admin.
/// `data` poartă doar câmpuri mici și ne-sensibile (motiv, sumă), niciodată tokenuri sau corpul emailului.
model EmailDispatch {
  id        String    @id @default(cuid())
  template  String
  eventKey  String
  recipient String
  /// customer | internal
  audience  String    @default("customer")
  orderId   String?
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String    @default("queued")
  attempts  Int       @default(0)
  /// Eroarea curățată (fără adrese, tokenuri sau corp), doar pentru diagnostic.
  lastError String?
  data      Json?
  claimedAt DateTime?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([eventKey, template, recipient])
  @@index([status, createdAt])
  @@index([orderId])
  @@map("email_dispatch")
}

/// Suprascrierea unui șablon de email (Faza 11): doar subiectul și textul de început; informațiile obligatorii legal ale
/// confirmării nu se pot scoate. Variabilele permise sunt ale șablonului (validate la salvare). Ștergerea rândului = revenire la implicit.
model EmailTemplateOverride {
  template  String   @id
  subject   String
  intro     String
  updatedBy String
  updatedAt DateTime @updatedAt

  @@map("email_template_override")
}

/// Linkul «reîncearcă plata»: jetonul în clar nu se stochează, doar amprenta SHA-256. Valabil până la `expiresAt`
/// (maximum sfârșitul ferestrei de 24 h a comenzii); un jeton nou îl invalidează pe cel vechi (`usedAt`).
model PaymentRetryToken {
  id        String    @id @default(cuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([orderId])
  @@map("payment_retry_token")
}

/// Adresa unei comenzi (livrare sau facturare), snapshot imuabil: textul rămâne cel de la plasare; `countySirutaCode` și
/// `localitySirutaCode` sunt coduri SIRUTA (cheie străină spre nomenclator; NU codul `JUD`). Codul poștal e introdus de client (doar format). La facturare pe firmă: `vatId` (CUI) cu `vatIdVerification`
/// = verified | unverified (ANAF nu a răspuns: comanda NU se blochează).
model Address {
  id                 String     @id @default(cuid())
  orderId            String
  order              Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// shipping | billing
  kind               String
  fullName           String
  company            String?
  vatId              String?
  vatIdVerification  String?
  tradeRegisterNo    String?
  phone              String
  countySirutaCode   Int
  county             SirutaUnit @relation("AddressCounty", fields: [countySirutaCode], references: [code], onDelete: Restrict)
  countyName         String
  localitySirutaCode Int
  locality           SirutaUnit @relation("AddressLocality", fields: [localitySirutaCode], references: [code], onDelete: Restrict)
  localityName       String
  street             String
  postalCode         String
  country            String     @default("RO")
  createdAt          DateTime   @default(now())

  @@unique([orderId, kind])
  @@index([countySirutaCode])
  @@index([localitySirutaCode])
  @@map("address")
}

/// Zonă de livrare pe județe (coduri `JUD` din SIRUTA), cu tarife fixe: REZERVA folosită când furnizorul de tarife nu răspunde.
model ShippingZone {
  id          String           @id @default(cuid())
  name        String
  isActive    Boolean          @default(true)
  countyCodes Int[]
  position    Int              @default(0)
  methods     ShippingMethod[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("shipping_zone")
}

/// Metodă de livrare cu tarif propriu. `zoneId` nul = disponibilă oriunde (ridicare personală). Tipuri: flat (preț fix),
/// weight (preț de bază pentru `rules.includedKg` kg + `rules.perExtraKgMinor` pe fiecare kg început în plus), pickup.
model ShippingMethod {
  id             String        @id @default(cuid())
  zoneId         String?
  zone           ShippingZone? @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  code           String
  name           String
  carrier        String?
  type           String
  priceMinor     Int
  rules          Json          @default("{}")
  /// Prag de transport gratuit propriu metodei (bani, cu TVA); nul = fără prag.
  freeAboveMinor Int?
  codFeeMinor    Int           @default(0)
  estimatedDays  Int?
  isActive       Boolean       @default(true)
  position       Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([zoneId, isActive])
  @@map("shipping_method")
}

/// Produse la care pragul de transport gratuit NU se aplică (bifat din ecranul «Coș și transport»; pe clasă: setarea
/// `checkout.freeShippingClasses`).
model FreeShippingExclusion {
  productId String   @id
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("free_shipping_exclusion")
}

/// Document fiscal al unei comenzi (Faza 13), ȘI rând de outbox: creat «în coadă» la evenimentul comenzii, în aceeași tranzacție,
/// emis de worker prin `InvoiceProvider`. `kind`: proforma | invoice | storno. `docKey` (unic pe comandă) face emiterea
/// idempotentă: `proforma`, `invoice`, `storno:total` sau `storno:<referință>` (storno parțial). Seria și numărul le definește
/// furnizorul (SmartBill): aplicația nu numerotează. `status`: queued | issuing | issued | failed | skipped. `failed` = epuizat sau
/// cu rezultat nesigur (cere decizia adminului), `skipped` = nu mai e nevoie (comanda anulată înainte de emitere). Un document emis
/// nu își mai schimbă câmpurile fiscale (trigger); nimic din costul de achiziție nu intră aici.
model Invoice {
  id                String         @id @default(cuid())
  orderId           String
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  kind              String
  docKey            String
  parentId          String?
  parent            Invoice?       @relation("InvoiceStorno", fields: [parentId], references: [id], onDelete: Restrict)
  stornos           Invoice[]      @relation("InvoiceStorno")
  status            String         @default("queued")
  /// smartbill | demo; setat doar la emitere.
  provider          String?
  /// Documentul emis de furnizorul DEMO: marcat «SIMULAT, nu este document fiscal» în interfață și în PDF.
  simulated         Boolean        @default(false)
  series            String?
  number            String?
  /// Identificatorul documentului la furnizor (SmartBill: `documentId`).
  providerRef       String?
  /// Link de vizualizare dat de furnizor (poate conține un hash); doar pentru admin.
  pdfUrl            String?
  /// not_applicable | unknown | pending | sent | validated | error. SmartBill nu expune statusul prin API: `unknown`.
  efacturaStatus    String         @default("not_applicable")
  efacturaCheckedAt DateTime?
  currency          String         @default("RON")
  totalMinor        Int
  taxMinor          Int
  /// Factura cere descărcarea de gestiune la furnizor (toate liniile de produs au stoc gestionat). Altfel se emite FĂRĂ descărcare.
  useStock          Boolean        @default(false)
  attempts          Int            @default(0)
  nextAttemptAt     DateTime?
  lastErrorCode     String?
  /// Mesaj scurt, fără date personale și fără corpul cererii sau al răspunsului.
  lastError         String?
  lockedAt          DateTime?
  /// Alerta de după 3 eșecuri a fost deja trimisă (o singură dată pe document).
  alertedAt         DateTime?
  issuedAt          DateTime?
  requestedBy       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  lines             InvoiceLine[]
  events            InvoiceEvent[]

  @@unique([orderId, docKey])
  @@index([status, nextAttemptAt])
  @@index([orderId])
  @@map("invoice")
}

/// Linia unui document, înghețată la crearea lui (snapshot): produs (din linia comenzii), transport sau taxă de ramburs. Sumele
/// sunt cu TVA inclus, ca pe comandă; `netMinor + taxMinor = lineTotalMinor`. Cantitatea e în zecimi de miime, cu cel mult 2
/// zecimale (SmartBill). La stornoul parțial, linia poartă cantitatea returnată.
model InvoiceLine {
  id             String   @id @default(cuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position       Int
  /// product | shipping | cod_fee
  kind           String
  orderLineId    String?
  sku            String?
  title          String
  unitName       String
  quantityTicks  BigInt
  unitPriceMinor Int
  lineTotalMinor Int
  netMinor       Int
  taxMinor       Int
  taxRateBps     Int
  /// Linia se descarcă din gestiune la furnizor (doar produse cu stoc gestionat).
  dischargeStock Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([invoiceId, position])
  @@map("invoice_line")
}

/// Jurnalul unui document (încercări, emitere, eșecuri, alertă, retrimitere). Doar se adaugă (trigger).
model InvoiceEvent {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type      String
  message   String
  data      Json?
  createdAt DateTime @default(now())

  @@index([invoiceId, createdAt])
  @@map("invoice_event")
}

// ---------------------------------------------------------------------------
// Faza 14: contul clientului și retururile (migrația `20261123100000_account_returns`, aditivă)
// ---------------------------------------------------------------------------

/// Adresă salvată în agenda clientului. NU e `Address` (acela e snapshot-ul imuabil al comenzii): se poate modifica și șterge.
/// Cel mult o adresă implicită de livrare și una de facturare pe client (indecși parțiali în migrație).
model CustomerAddress {
  id                 String     @id @default(cuid())
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  label              String?
  fullName           String
  company            String?
  vatId              String?
  vatIdVerification  String?
  tradeRegisterNo    String?
  phone              String
  countySirutaCode   Int
  county             SirutaUnit @relation("CustomerAddressCounty", fields: [countySirutaCode], references: [code], onDelete: Restrict)
  countyName         String
  localitySirutaCode Int
  locality           SirutaUnit @relation("CustomerAddressLocality", fields: [localitySirutaCode], references: [code], onDelete: Restrict)
  localityName       String
  street             String
  postalCode         String
  country            String     @default("RO")
  isDefaultShipping  Boolean    @default(false)
  isDefaultBilling   Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([userId])
  @@index([countySirutaCode])
  @@index([localitySirutaCode])
  @@map("customer_address")
}

/// Wishlist (Faza 14, în spatele flag-ului `wishlist`): o variantă o singură dată pe client.
model WishlistItem {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, variantId])
  @@index([variantId])
  @@map("wishlist_item")
}

/// Preferințele de comunicare ale clientului. Emailurile despre comenzi sunt de serviciu (nu se opresc, nu sunt aici). «Oferte și
/// noutăți» e un consimțământ de marketing, implicit OPRIT; ultima decizie păstrează momentul și textul exact arătat. Faza 14 nu
/// trimite nimic de marketing (îl va folosi Faza 17).
model CustomerPreference {
  userId                String    @id
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketingOptIn        Boolean   @default(false)
  marketingDecisionAt   DateTime?
  marketingDecisionText String?
  /// Telefonul clientului (profil), normalizat `+40…`; nul dacă nu l-a completat. Se șterge la anonimizare.
  phone                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("customer_preference")
}

/// Cererea de retur (Faza 14). `status`: requested | approved | awaiting_shipment | received | inspected | refunded | rejected |
/// cancelled (state machine în `packages/core/src/returns`, păzit și de un trigger). Suma rambursată = DOAR produsele returnate (decizia
/// 2026-11-22); transportul îl poate adăuga adminul manual, cu motiv. Rambursarea efectivă o face serviciul din Faza 10 (`refundId`).
/// `adminNote` e INTERN și nu ajunge niciodată la client.
model ReturnRequest {
  id                   String        @id @default(cuid())
  number               Int           @unique @default(autoincrement())
  orderId              String
  order                Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// Cheia de idempotență a inițierii (dublu-click): aceeași cheie întoarce același retur.
  clientKey            String
  status               String        @default("requested")
  /// Motivul general, opțional, scris de client.
  customerNote         String?
  /// courier | drop_off: cum trimite clientul coletul.
  sendMode             String        @default("courier")
  returnCarrier        String?
  returnAwb            String?
  returnTrackingUrl    String?
  returnAwbAt          DateTime?
  /// Motivul respingerii, VIZIBIL clientului; nota internă nu.
  rejectReason         String?
  adminNote            String?
  refundId             String?
  refund               Refund?       @relation(fields: [refundId], references: [id], onDelete: Restrict)
  refundProductsMinor  Int?
  refundShippingMinor  Int           @default(0)
  refundShippingReason String?
  /// null | queued | covered_by_total | not_needed | failed: soarta stornoului parțial emis la rambursare.
  stornoState          String?
  stornoNote           String?
  requestedAt          DateTime      @default(now())
  approvedAt           DateTime?
  receivedAt           DateTime?
  inspectedAt          DateTime?
  refundedAt           DateTime?
  rejectedAt           DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  items                ReturnItem[]
  events               ReturnEvent[]

  @@unique([userId, clientKey])
  @@index([orderId])
  @@index([status, requestedAt])
  @@index([refundId])
  @@map("return_request")
}

/// O linie dintr-un retur. Cantitățile sunt `BIGINT` cu 4 zecimale (`Quantity`), multiplu exact al pasului de vânzare. Suma cantităților
/// active ale unei linii de comandă nu depășește cantitatea comandată (trigger cu blocarea liniei, testat cu cereri simultane).
model ReturnItem {
  id              String        @id @default(cuid())
  returnId        String
  return          ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderLineId     String
  orderLine       OrderLine     @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  requestedQty    BigInt
  /// Stabilite la inspecție, toate trei odată: cantitatea acceptată, starea constatată și dacă produsul se poate revinde.
  acceptedQty     BigInt?
  /// as_new | opened | damaged | defective | wrong_item
  condition       String?
  resellable      Boolean?
  /// Suma rambursată pentru linie (bani, cu TVA), calculată o singură dată la propunerea rambursării.
  refundLineMinor Int?
  /// Faza 15b: partea de reducere din puncte a bucăților returnate, în bani (`refundLineMinor` = banii).
  loyaltyDiscountMinor Int          @default(0)
  reasonCode      String
  reasonText      String?
  /// Repunerea pe stoc: o singură dată (`restockedAt` + cheia mișcării de stoc).
  restockedAt     DateTime?
  createdAt       DateTime      @default(now())

  @@unique([returnId, orderLineId])
  @@index([orderLineId])
  @@map("return_item")
}

/// Jurnalul unui retur: doar se adaugă. `visibleToCustomer` = lista albă a timeline-ului din cont; notele interne nu sunt vizibile.
model ReturnEvent {
  id                String        @id @default(cuid())
  returnId          String
  return            ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  type              String
  message           String
  visibleToCustomer Boolean       @default(false)
  data              Json?
  actorLabel        String?
  createdAt         DateTime      @default(now())

  @@index([returnId, createdAt])
  @@map("return_event")
}

// ---------------------------------------------------------------------------
// Faza 14b: produse digitale (docs/11). Migrare ADITIVĂ. Cheile de stocare (`storageKey`) și secretele NU ies din server.
// ---------------------------------------------------------------------------

/// Extensia 1:1 a unui produs `digital`: cum se livrează, cât ține accesul, limita de descărcări. `accessType` = lifetime (decis:
/// acces pe viață); `accessDays` rămâne în schemă, nefolosit. `requiresLogin` e mereu adevărat (CHECK). `maxDownloads` gol = nelimitat.
model DigitalProduct {
  productId     String         @id
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// download | stream | external_link (CHECK)
  deliveryType  String         @default("download")
  /// lifetime | limited_days (CHECK; doar lifetime se folosește)
  accessType    String         @default("lifetime")
  accessDays    Int?
  maxDownloads  Int?
  requiresLogin Boolean        @default(true)
  /// Textele de pe pagina produsului: ce primești, cerințe, format.
  whatYouGet    String?
  requirements  String?
  format        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  assets        DigitalAsset[]

  @@map("digital_product")
}

/// Un fișier, un videoclip sau o legătură a produsului digital (un «modul»). `provider`: unde stă conținutul (local | bunny | s3);
/// `storageKey`: cheia din storage sau id-ul videoclipului la Bunny. ⚠️ DOAR pe server: niciodată în props, API, loguri sau export.
model DigitalAsset {
  id              String             @id @default(cuid())
  productId       String
  digital         DigitalProduct     @relation(fields: [productId], references: [productId], onDelete: Cascade)
  title           String
  /// video | file | link (CHECK)
  type            String
  /// local | bunny | s3 (CHECK); nul la `link`
  provider        String?
  storageKey      String?
  /// https, doar la `link`
  externalUrl     String?
  originalName    String?
  mimeType        String?
  fileSize        BigInt?
  durationSeconds Int?
  position        Int                @default(0)
  /// Lecție de preview: se poate viziona gratuit, fără achiziție.
  isPreview       Boolean            @default(false)
  /// processing | ready | failed (la Bunny, transcodarea)
  status          String             @default("ready")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  accessLogs      DigitalAccessLog[]

  @@index([productId, position])
  @@map("digital_asset")
}

/// Dreptul de acces al unui client la o linie digitală de comandă (unic pe linie). Creat DOAR la momentul din decizia 1 (card: plata
/// confirmată; transfer: «Marchează plătit»; ramburs mixt: livrare confirmată), revocat la rambursarea liniei. `downloadCount` crește
/// printr-un UPDATE condiționat (limita atomică); `accessToken` e identificatorul opac din adrese (nu id-ul intern).
model DigitalEntitlement {
  id            String             @id @default(cuid())
  orderId       String
  order         Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderLineId   String             @unique
  orderLine     OrderLine          @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  customerId    String
  customer      User               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  productId     String
  product       Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  accessToken   String             @unique
  /// payment | delivery | admin: de ce s-a acordat accesul.
  grantReason   String
  grantedAt     DateTime           @default(now())
  /// Nul = pe viață.
  expiresAt     DateTime?
  downloadCount Int                @default(0)
  maxDownloads  Int?
  revokedAt     DateTime?
  revokedReason String?
  revokedBy     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  accessLogs    DigitalAccessLog[]

  @@index([customerId, grantedAt])
  @@index([orderId])
  @@index([productId])
  @@map("digital_entitlement")
}

/// Jurnalul accesărilor (audit și anti-piraterie). IP-ul și user-agent-ul se păstrează doar cât cere funcția (setarea
/// `digital.accessLogRetentionDays`) și se anonimizează (devin nule) la ștergerea contului.
model DigitalAccessLog {
  id            String             @id @default(cuid())
  entitlementId String
  entitlement   DigitalEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  assetId       String?
  asset         DigitalAsset?      @relation(fields: [assetId], references: [id], onDelete: SetNull)
  /// view | download (CHECK)
  action        String
  ip            String?
  userAgent     String?
  createdAt     DateTime           @default(now())

  @@index([entitlementId, createdAt])
  @@index([createdAt])
  @@map("digital_access_log")
}

// ---------------------------------------------------------------------------
// Faza 15b: puncte de loialitate. Registrul e IMUABIL (triggere în migrare); soldul se schimbă doar prin tranzacții.
// ---------------------------------------------------------------------------

model LoyaltyAccount {
  customerId   String               @id
  customer     User                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// Ținut la zi de trigger din registru; nu se scrie niciodată direct. Poate fi negativ doar după un retur.
  balance      Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @default(now()) @updatedAt
  transactions LoyaltyTransaction[]
  lots         LoyaltyLot[]

  @@map("loyalty_account")
}

model LoyaltyTransaction {
  id             String            @id @default(cuid())
  seq            BigInt            @unique @default(autoincrement())
  customerId     String
  account        LoyaltyAccount    @relation(fields: [customerId], references: [customerId], onDelete: Cascade)
  /// Fără cheie externă: registrul nu depinde de ștergerea datelor de probă.
  orderId        String?
  type           String
  points         Int
  /// Calculat de trigger la inserare.
  balanceAfter   Int               @default(0)
  reason         String?
  /// Doar la ajustarea manuală: contul din admin care a făcut-o (fără email sau nume).
  actorId        String?
  idempotencyKey String            @unique
  createdAt      DateTime          @default(now())
  lots           LoyaltyLot[]
  entries        LoyaltyLotEntry[]

  @@index([customerId, seq])
  @@index([orderId])
  @@map("loyalty_transaction")
}

/// Un lot de puncte cu data lui de expirare: din acumulare, ajustare pozitivă sau puncte întoarse.
model LoyaltyLot {
  id            String             @id @default(cuid())
  transactionId String
  transaction   LoyaltyTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  customerId    String
  account       LoyaltyAccount     @relation(fields: [customerId], references: [customerId], onDelete: Cascade)
  /// La punctele întoarse: lotul din care plecaseră.
  originLotId   String?
  originLot     LoyaltyLot?        @relation("LoyaltyLotOrigin", fields: [originLotId], references: [id], onDelete: Cascade)
  restoredLots  LoyaltyLot[]       @relation("LoyaltyLotOrigin")
  points        Int
  /// Scade doar prin `LoyaltyLotEntry` (trigger).
  remaining     Int
  expiresAt     DateTime
  warnedAt      DateTime?
  createdAt     DateTime           @default(now())
  entries       LoyaltyLotEntry[]

  @@index([customerId, expiresAt])
  @@index([expiresAt])
  @@index([transactionId])
  @@index([originLotId])
  @@map("loyalty_lot")
}

/// Ce a consumat o tranzacție dintr-un lot (mereu negativ).
model LoyaltyLotEntry {
  id            String             @id @default(cuid())
  transactionId String
  transaction   LoyaltyTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  lotId         String
  lot           LoyaltyLot         @relation(fields: [lotId], references: [id], onDelete: Cascade)
  points        Int
  createdAt     DateTime           @default(now())

  @@unique([transactionId, lotId])
  @@index([lotId])
  @@map("loyalty_lot_entry")
}
