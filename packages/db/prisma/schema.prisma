generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String     @id
  name          String
  email         String
  emailVerified Boolean    @default(false)
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sessions      Session[]
  accounts      Account[]
  roles         UserRole[]
  mediaUploads  Media[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Configurare white-label (o instalare = un magazin, fără tenantId)
// ---------------------------------------------------------------------------

/// Setări tipate pe grupuri (general, company, regional, tax, ...). Cheia e `grup.nume`.
model Setting {
  key       String   @id
  group     String
  value     Json
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("setting")
}

/// Un singur rând (id = "default"): token-urile temei, injectate ca CSS variables.
model Branding {
  id         String   @id @default("default")
  preset     String   @default("minimal")
  colors     Json
  fonts      Json
  radius     String
  darkMode   Boolean  @default(false)
  logoUrl    String?
  faviconUrl String?
  ogImageUrl String?
  customCss  String?
  updatedAt  DateTime @updatedAt

  @@map("branding")
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt

  @@map("feature_flag")
}

/// Integrări externe (plăți, curieri, facturare). `credentials` e criptat AES-256-GCM
/// cu APP_KEY și nu iese niciodată în clar din server.
model Integration {
  id          String   @id @default(cuid())
  type        String
  provider    String
  credentials String?
  config      Json     @default("{}")
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([type, provider])
  @@map("integration")
}

/// Jurnal DOAR DE ADĂUGARE: triggerele din migrația audit_log_append_only resping UPDATE/DELETE/TRUNCATE.
/// `actorId` nu e cheie străină: jurnalul trebuie să supraviețuiască ștergerii utilizatorului,
/// iar un ON DELETE SET NULL ar fi un UPDATE. `actorLabel` = emailul actorului la momentul acțiunii.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorLabel String?
  action     String
  entity     String
  entityId   String?
  before     Json?
  after      Json?
  requestId  String?
  /// "success" | "denied" | "failed" (constrângere CHECK în migrație)
  outcome    String   @default("success")
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// RBAC: permisiuni ca string-uri (ex. products.cost.view)
// ---------------------------------------------------------------------------

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  users       UserRole[]

  @@map("role")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role")
}

// ---------------------------------------------------------------------------
// Media (Faza 3): fișierele din biblioteca magazinului
// ---------------------------------------------------------------------------

/// Folder din biblioteca media. Arbore prin `parentId`; numele e unic în același părinte
/// (indecșii parțiali, fără diferență de majuscule, sunt în migrația media_library).
model MediaFolder {
  id        String        @id @default(cuid())
  name      String
  parentId  String?
  parent    MediaFolder?  @relation("MediaFolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  MediaFolder[] @relation("MediaFolderTree")
  media     Media[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([parentId])
  @@map("media_folder")
}

/// Un fișier din bibliotecă. `storageKey` = originalul FĂRĂ EXIF/GPS (păstrat pentru a
/// regenera variantele); `variants` = lista variantelor generate din job. Numele original
/// al fișierului e doar informativ în admin și nu apare niciodată într-un URL.
model Media {
  id              String         @id @default(cuid())
  /// "pending" | "processing" | "ready" | "failed" (constrângere CHECK în migrație)
  status          String         @default("pending")
  mime            String
  sizeBytes       Int
  width           Int?
  height          Int?
  /// SHA-256 (hex) al originalului stocat; permite detectarea dublurilor
  checksum        String
  originalName    String
  storageKey      String         @unique
  /// [{ name, format, key, width, height, sizeBytes }]
  variants        Json           @default("[]")
  blurhash        String?
  alt             String         @default("")
  tags            String[]       @default([])
  folderId        String?
  folder          MediaFolder?   @relation(fields: [folderId], references: [id], onDelete: Restrict)
  processingError String?
  uploadedById    String?
  uploadedBy      User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  productMedia    ProductMedia[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([folderId])
  @@index([status])
  @@index([checksum])
  @@index([createdAt])
  @@index([uploadedById])
  @@index([tags], type: Gin)
  @@map("media")
}

// ---------------------------------------------------------------------------
// Catalog (Faza 4): produse, variante, categorii, branduri, media pe produs
// ---------------------------------------------------------------------------

/// Brandul produselor (opțional pe produs; eMAG îl cere la publicare). `legacyId`/`legacyUrl` = identificatorul și
/// adresa din magazinul WooCommerce de unde se migrează (import repetabil + redirecționări 301 la lansare).
model Brand {
  id             String    @id @default(cuid())
  slug           String    @unique
  name           String
  description    String?
  seoTitle       String?
  seoDescription String?
  legacyId       String?   @unique
  legacyUrl      String?
  products       Product[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("brand")
}

/// Categorie într-un arbore (`parentId`). `path` = calea de slug-uri (ex. `pompe/pompe-filtrare`),
/// `depth` = adâncimea (0 = rădăcină); ambele sunt calculate de serviciu, nu editate direct.
model Category {
  id                       String            @id @default(cuid())
  parentId                 String?
  parent                   Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children                 Category[]        @relation("CategoryTree")
  slug                     String
  name                     String
  description              String?
  path                     String            @unique
  depth                    Int               @default(0)
  sortOrder                Int               @default(0)
  /// Produsele din categorie costă prețul public pentru toate grupurile (`09` §1)
  excludeFromGroupDiscount Boolean           @default(false)
  seoTitle                 String?
  seoDescription           String?
  legacyId                 String?           @unique
  legacyUrl                String?
  products                 ProductCategory[]
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([parentId])
  @@map("category")
}

/// Produsul vandabil. Prețurile, EAN-ul, garanția, greutatea și costul stau pe VARIANTĂ (un produs
/// simplu are o singură variantă implicită). `slug` e unic printre produsele neșterse (index parțial în
/// migrație). `deletedAt` = soft delete.
model Product {
  id                       String              @id @default(cuid())
  slug                     String
  title                    String
  subtitle                 String?
  description              String?
  /// "draft" | "active" | "archived" (CHECK în migrație)
  status                   String              @default("draft")
  /// "physical" | "digital" (CHECK în migrație)
  type                     String              @default("physical")
  /// Opțional: magazinul poate să nu folosească mărci. Obligatoriu doar la publicarea pe un canal care îl cere (eMAG).
  brandId                  String?
  brand                    Brand?              @relation(fields: [brandId], references: [id], onDelete: Restrict)
  /// Pregătit pentru cote reduse; nefolosit (vezi `TaxClass`). Calculul folosește `tax.standardRate`.
  taxClassId               String?
  taxClass                 TaxClass?           @relation(fields: [taxClassId], references: [id], onDelete: Restrict)
  /// "standard" | "oversized" | "pallet" (CHECK în migrație). Regulile pe clase vin la Faza 12.
  shippingClass            String              @default("standard")
  requiresInstallation     Boolean             @default(false)
  /// Valoarea implicită vine din setarea `inventory.manageStock`; aici e suprascrierea per produs.
  manageStock              Boolean             @default(true)
  /// "instock" | "outofstock" | "onbackorder" (CHECK); folosit când `manageStock = false`
  stockStatus              String              @default("instock")
  excludeFromGroupDiscount Boolean             @default(false)
  seoTitle                 String?
  seoDescription           String?
  publishedAt              DateTime?
  sortOrder                Int                 @default(0)
  metadata                 Json                @default("{}")
  legacyId                 String?             @unique
  legacyUrl                String?
  deletedAt                DateTime?
  variants                 ProductVariant[]
  categories               ProductCategory[]
  media                    ProductMedia[]
  options                  ProductOption[]
  attributes               AttributeValue[]
  collections              CollectionProduct[]
  relations                ProductRelation[]   @relation("ProductRelations")
  relatedTo                ProductRelation[]   @relation("RelatedProducts")
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@index([brandId])
  @@index([taxClassId])
  @@index([status])
  @@index([deletedAt])
  @@map("product")
}

model ProductCategory {
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// O singură categorie primară per produs (index parțial în migrație)
  isPrimary  Boolean  @default(false)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_category")
}

/// Variantă vandabilă. Sumele sunt `int` în bani. `price` = BRUT (cu TVA inclus), `salePrice` = prețul
/// promoțional brut (în intervalul `saleStartsAt`–`saleEndsAt`, dacă sunt setate). `costPrice` = prețul de
/// achiziție NET (fără TVA), ⚠️ DOAR pentru admin (`products.cost.view`): niciodată în API public, props
/// către componente client, feed-uri, snapshot de comandă sau loguri.
model ProductVariant {
  id             String               @id @default(cuid())
  productId      String
  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String               @unique
  /// GTIN (8-14 cifre). Nu e NOT NULL în bază (draft-uri, import); obligatoriu la publicarea pe eMAG.
  ean            String?
  /// Garanția în luni. Nu e NOT NULL în bază (valoarea implicită e o decizie de business); obligatorie la eMAG.
  warrantyMonths Int?
  price          Int
  salePrice      Int?
  saleStartsAt   DateTime?
  saleEndsAt     DateTime?
  costPrice      Int?
  costPriceDate  DateTime?
  /// Greutate în grame, dimensiuni în milimetri (întregi; transportul folosește max(real, volumetric))
  weightGrams    Int?
  lengthMm       Int?
  widthMm        Int?
  heightMm       Int?
  /// Suprascrierea per variantă a lui `Product.manageStock` (null = moștenește de la produs)
  manageStock    Boolean?
  /// "instock" | "outofstock" | "onbackorder" (CHECK); suprascrie `Product.stockStatus` (null = moștenește)
  stockStatus    String?
  position       Int                  @default(0)
  isDefault      Boolean              @default(false)
  legacyId       String?              @unique
  media          ProductMedia[]
  costHistory    CostPriceHistory[]
  priceHistory   PriceHistory[]
  optionValues   VariantOptionValue[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([id, productId])
  @@index([productId])
  @@index([ean])
  @@map("product_variant")
}

/// Istoricul prețurilor de achiziție NET. ⚠️ DOAR admin, ca `ProductVariant.costPrice`.
model CostPriceHistory {
  id            String         @id @default(cuid())
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  costPrice     Int
  effectiveDate DateTime
  /// "manual" | "import" (CHECK în migrație)
  source        String
  importId      String?
  createdAt     DateTime       @default(now())

  @@index([variantId, effectiveDate])
  @@map("cost_price_history")
}

/// Prețul public brut în vigoare al unei variante de la `effectiveFrom` încolo (valoarea efectivă:
/// min(preț, promoție activă)). Sursa pentru „cel mai mic preț din ultimele 30 de zile” (Omnibus).
/// Se scrie la fiecare schimbare a prețului efectiv; vezi `lowestPriceInWindow` din `@ecom/core`.
model PriceHistory {
  id            String         @id @default(cuid())
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  price         Int
  effectiveFrom DateTime

  @@unique([variantId, effectiveFrom])
  @@map("price_history")
}

/// Fișier din bibliotecă atașat unui produs (sau unei variante a lui). `onDelete: Restrict` spre `Media`
/// e plasa de siguranță sub `ProductMediaUsageProvider`: un fișier folosit nu se poate șterge nici dacă
/// providerul nu e înregistrat. `position` 0 = imaginea principală.
model ProductMedia {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId, productId], references: [id, productId], onDelete: Cascade)
  mediaId   String
  media     Media           @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  position  Int             @default(0)
  createdAt DateTime        @default(now())

  @@index([productId, position])
  @@index([variantId])
  @@index([mediaId])
  @@map("product_media")
}

// ---------------------------------------------------------------------------
// Catalog (Faza 4, punctul 3): opțiuni, colecții, atribute, relații, clase de taxare
// ---------------------------------------------------------------------------

/// Opțiune de variantă (ex. „Mărime”, „Culoare”) a unui produs. Numele e unic per produs (fără
/// diferență de majuscule, index parțial în migrație).
model ProductOption {
  id        String               @id @default(cuid())
  productId String
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  position  Int                  @default(0)
  values    OptionValue[]
  variants  VariantOptionValue[]

  @@unique([id, productId])
  @@index([productId, position])
  @@map("product_option")
}

model OptionValue {
  id       String               @id @default(cuid())
  optionId String
  option   ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value    String
  position Int                  @default(0)
  variants VariantOptionValue[]

  @@unique([id, optionId])
  @@index([optionId, position])
  @@map("option_value")
}

/// Valoarea unei opțiuni pentru o variantă. Cheile compuse garantează în bază că varianta, opțiunea și
/// valoarea sunt ale aceluiași produs și că o variantă are cel mult o valoare per opțiune (PK).
model VariantOptionValue {
  variantId     String
  productId     String
  optionId      String
  optionValueId String
  variant       ProductVariant @relation(fields: [variantId, productId], references: [id, productId], onDelete: Cascade)
  option        ProductOption  @relation(fields: [optionId, productId], references: [id, productId], onDelete: Cascade)
  value         OptionValue    @relation(fields: [optionValueId, optionId], references: [id, optionId], onDelete: NoAction)

  @@id([variantId, optionId])
  @@index([optionValueId])
  @@map("variant_option_value")
}

/// Colecție de produse: `manual` (listă în `CollectionProduct`) sau `automated` (reguli în `rules`,
/// evaluate de storefront în Faza 7).
model Collection {
  id             String              @id @default(cuid())
  slug           String
  name           String
  description    String?
  /// "manual" | "automated" (CHECK în migrație)
  type           String              @default("manual")
  rules          Json                @default("{}")
  sortOrder      Int                 @default(0)
  seoTitle       String?
  seoDescription String?
  legacyId       String?             @unique
  products       CollectionProduct[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@map("collection")
}

model CollectionProduct {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  position     Int        @default(0)

  @@id([collectionId, productId])
  @@index([productId])
  @@map("collection_product")
}

/// Atribut tehnic. `type` = text | number | select | bool. Cele `number` au unitate de măsură (`unit`:
/// m³/h, kW, m³) și, dacă `isFilterable`, se filtrează pe interval (slider) în Faza 7; valorile se
/// stochează ca numere exacte (`numberValue`), nu ca text. `code` e cheia stabilă (import, filtre).
model Attribute {
  id           String            @id @default(cuid())
  code         String            @unique
  name         String
  /// "text" | "number" | "select" | "bool" (CHECK în migrație)
  type         String
  /// Doar la `number` (CHECK în migrație)
  unit         String?
  isFilterable Boolean           @default(false)
  sortOrder    Int               @default(0)
  options      AttributeOption[]
  values       AttributeValue[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("attribute")
}

/// Valoare permisă a unui atribut de tip `select`.
model AttributeOption {
  id          String           @id @default(cuid())
  attributeId String
  attribute   Attribute        @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  position    Int              @default(0)
  values      AttributeValue[]

  @@unique([id, attributeId])
  @@index([attributeId, position])
  @@map("attribute_option")
}

/// Valoarea unui atribut pe un produs. Exact UNA dintre `textValue`, `numberValue`, `boolValue`,
/// `optionId` e setată (CHECK), iar un trigger din migrație cere ca ea să corespundă tipului atributului.
/// `numberValue`: NUMERIC(18,4), exact (nu `float`).
model AttributeValue {
  id          String           @id @default(cuid())
  productId   String
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   Attribute        @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  textValue   String?
  numberValue Decimal?         @db.Decimal(18, 4)
  boolValue   Boolean?
  optionId    String?
  option      AttributeOption? @relation(fields: [optionId, attributeId], references: [id, attributeId], onDelete: Restrict)

  @@unique([productId, attributeId])
  @@index([attributeId, numberValue])
  @@index([attributeId, optionId])
  @@map("attribute_value")
}

/// Relație între produse. Sensul: `productId` e produsul „principal”, `relatedProductId` cel asociat:
/// `accessory` / `upsell` / `crosssell` / `similar` (ale produsului principal), `spare_part` (piesa de
/// schimb a produsului principal) și `compatible_with` (produsul principal e compatibil cu cel asociat).
model ProductRelation {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation("ProductRelations", fields: [productId], references: [id], onDelete: Cascade)
  relatedProductId String
  relatedProduct   Product  @relation("RelatedProducts", fields: [relatedProductId], references: [id], onDelete: Cascade)
  /// "similar" | "accessory" | "upsell" | "crosssell" | "spare_part" | "compatible_with" (CHECK)
  type             String
  position         Int      @default(0)
  createdAt        DateTime @default(now())

  @@unique([productId, relatedProductId, type])
  @@index([relatedProductId])
  @@map("product_relation")
}

/// Clasă de taxare, PREGĂTITĂ pentru cote reduse pe viitor. DECIZIE (utilizator, Faza 4): produsele
/// folosesc doar cota standard din setarea `tax.standardRate` (21%); `TaxClass`/`TaxRate` nu sunt
/// expuse în admin, nu schimbă calculul prețurilor și nu se seedează nicio cotă (nimic hardcodat).
model TaxClass {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  isDefault Boolean   @default(false)
  rates     TaxRate[]
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("tax_class")
}

/// Cota unei clase de taxare, în puncte de bază (`2100` = 21%), valabilă de la `validFrom`.
model TaxRate {
  id         String   @id @default(cuid())
  taxClassId String
  taxClass   TaxClass @relation(fields: [taxClassId], references: [id], onDelete: Cascade)
  rateBps    Int
  validFrom  DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([taxClassId, validFrom])
  @@map("tax_rate")
}
