{
  "name": "ecom-package",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "dev": "node scripts/in.mjs apps/web node_modules/next/dist/bin/next dev",
    "dev:web": "node scripts/in.mjs apps/web node_modules/next/dist/bin/next dev",
    "worker": "node scripts/worker.mjs",
    "dev:mail": "node --import tsx packages/core/scripts/dev-mail.ts",
    "build:web": "node scripts/in.mjs apps/web node_modules/next/dist/bin/next build",
    "check:local": "node scripts/run-all.mjs typecheck && node scripts/run-all.mjs lint && npm run lint:root && npm run format:check && npm run test",
    "build": "node scripts/run-all.mjs build",
    "lint": "node scripts/run-all.mjs lint",
    "typecheck": "node scripts/run-all.mjs typecheck",
    "test": "vitest run --project unit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:s3": "node scripts/e2e-s3.mjs",
    "test:integration": "vitest run --project integration",
    "lint:root": "eslint e2e test scripts vitest.config.mts playwright.config.ts eslint.config.mjs commitlint.config.mjs",
    "db:migrate": "node scripts/in.mjs packages/db node_modules/prisma/build/index.js migrate dev",
    "db:seed": "node --import tsx packages/core/scripts/seed.ts",
    "db:studio": "node scripts/in.mjs packages/db node_modules/prisma/build/index.js studio",
    "db:seed:store": "node --import tsx packages/core/scripts/seed-store.ts",
    "dev:seed-products": "node --import tsx packages/core/scripts/dev-seed-products.ts",
    "dev:availability": "node --import tsx packages/core/scripts/dev-availability.ts",
    "dev:stock-race": "node --import tsx packages/core/scripts/dev-stock-race.ts",
    "dev:stock-adjust": "node --import tsx packages/core/scripts/dev-stock-adjust.ts",
    "dev:seed-stock": "node --import tsx packages/core/scripts/dev-seed-stock.ts",
    "dev:stock-jobs": "node --import tsx packages/jobs/scripts/dev-stock-jobs.ts",
    "stock:jobs": "node --import tsx packages/jobs/scripts/stock-jobs.ts",
    "dev:perf-catalog": "node --import tsx packages/core/scripts/dev-perf-catalog.ts",
    "dev:preset": "node --import tsx packages/core/scripts/dev-apply-preset.ts",
    "admin:unlock": "node --import tsx packages/core/scripts/admin-unlock.ts",
    "rbac:revoke": "node --import tsx packages/core/scripts/rbac-revoke.ts",
    "storage:init": "node --import tsx packages/core/scripts/storage-init.ts",
    "media:regenerate": "node --import tsx packages/jobs/scripts/media-regenerate.ts",
    "media:recent": "node --import tsx packages/core/scripts/media-recent.ts",
    "docs:sweep-orphans": "node --import tsx packages/core/scripts/docs-sweep-orphans.ts",
    "turbo:lint": "turbo run lint",
    "turbo:typecheck": "turbo run typecheck",
    "turbo:build": "turbo run build",
    "admin:create": "node --import tsx packages/core/scripts/admin-create.ts",
    "dev:age-session": "node --import tsx packages/core/scripts/dev-age-session.ts",
    "admin:set-password": "node --import tsx packages/core/scripts/admin-set-password.ts",
    "cli:tty-test": "node --import tsx packages/core/scripts/tty-test.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.0",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^15.5.27",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "turbo": "^2.5.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,yml,yaml,md,mdx,mts,cts,cjs}": [
      "prettier --write"
    ]
  }
}
