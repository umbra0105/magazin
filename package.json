{
  "name": "ecom-package",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --project unit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --project integration",
    "lint:root": "eslint e2e test vitest.config.mts playwright.config.ts eslint.config.mjs commitlint.config.mjs",
    "db:migrate": "pnpm --filter @ecom/db db:migrate",
    "db:seed": "pnpm --filter @ecom/db db:seed",
    "db:studio": "pnpm --filter @ecom/db db:studio",
    "db:seed:store": "pnpm --filter @ecom/core db:seed:store",
    "dev:preset": "pnpm --filter @ecom/core dev:preset"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.0",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^15.5.27",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "turbo": "^2.5.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
