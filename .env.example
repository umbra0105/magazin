# Copiază în .env. Aici stau DOAR secrete și conexiuni.
# Numele magazinului, culorile, datele firmei, TVA etc. sunt în baza de date (admin).

NODE_ENV=development

# URL-ul public al aplicației (fără slash final)
APP_URL=http://localhost:3000

# Cheia de criptare a credențialelor de integrare (AES-256-GCM), 32 de octeți base64.
# Generează cu: openssl rand -base64 32
# ⚠️ Dacă o pierzi, credențialele criptate din baza de date devin ilizibile. Fă-i backup.
# Cheia de mai jos este DOAR pentru dezvoltare locală. Nu o folosi în producție.
APP_KEY=ZGV2LW9ubHktYXBwLWtleS0zMi1ieXRlcy1sb25nISE=

# PostgreSQL (docker/docker-compose.dev.yml)
DATABASE_URL=postgresql://ecom:ecom_dev@localhost:5432/ecom

# Redis (cache, sesiuni, cozi BullMQ)
REDIS_URL=redis://localhost:6379

# Teste de integrare (opțional). Implicit: baza <DATABASE_URL>_test (ex. ecom_test) și Redis DB 1,
# create/migrate automat. Testele refuză orice bază fără "test" în nume și Redis DB 0.
# TEST_DATABASE_URL=postgresql://ecom:ecom_dev@localhost:5432/ecom_test
# TEST_REDIS_URL=redis://localhost:6379/1

# Stocare fișiere: local | s3
STORAGE_DRIVER=s3
# Dacă STORAGE_DRIVER=local:
# STORAGE_LOCAL_PATH=./storage
# Dacă STORAGE_DRIVER=s3 (orice furnizor S3-compatibil; mai jos, MinIO din docker compose):
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ecom
S3_ACCESS_KEY_ID=ecom_minio
S3_SECRET_ACCESS_KEY=ecom_minio_dev
# true pentru MinIO și majoritatea self-hosted; false pentru AWS S3 / R2
S3_FORCE_PATH_STYLE=true

# Opțional: monitorizare erori
# SENTRY_DSN=
